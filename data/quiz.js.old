window.LJ_QUIZ=[{"q":"「6.神权卡」出自哪一篇？","o":["第一期：除魔卫道","第十期：新世纪~未来纪元","第二十八期：隐曜逆元","第四期：幻年降临~2020"],"a":0,"d":"m1-002","an":"e8","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"「不断跨越再超越」的效果是？","o":["处理一直以来未解决的神兽机制，开创新模式以适配完善“终决”弊端，创造新型强度技能卡。 完善三大机制：模式决战、技能威望、神兽威望","太初之时，混沌黑暗，以光明显现， 大道初立，是为正道。","掷骰子后自行扩大倍数，抽取神兽区对应位置精灵(扩大倍数在神兽区可数范围内)","第一代版本：除魔卫道、庆牛年"],"a":0,"d":"core-003","an":"e91","k":"body","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"「6.天蝎座」出自哪一篇？","o":["第二十五期：祈愿护梦~庆兔年","第九期：九妖王归位","第十三期：十二星座","第六期：宇宙原理"],"a":2,"d":"m1-012","an":"e6","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"效果：「满血时，血值×2，残血或阵亡时仅增1倍血」\n这是哪一张？","o":["8.酉鸡","5.亥猪","6.申猴","4.巳蛇"],"a":2,"d":"m1-011","an":"e9","k":"name","x":"出自《第十二期：十二生肖》"},{"q":"效果：「每次攻击附带全场每人的50%」\n这是哪一张？","o":["6.判官令/阎罗令","11.冰川怒","5.龙腾","9.横扫千军"],"a":3,"d":"m1-020","an":"e33","k":"name","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「掷骰子决定所有玩家要丢弃的精灵」出自哪一篇？","o":["第二十六期：隐曜洞徽","第三十七期：斩神联动","第三十八期：完美世界~帝关之战","第三期：五行元素"],"a":2,"d":"m1-026","an":"e18","k":"src","x":"原文：《第三十八期：完美世界~帝关之战》"},{"q":"「机制五十五：机制限定----战至终章」的效果是？","o":["任何技能卡都不会被抵消，不会被随意丢弃，不会丧失技能。","令普通精灵和三级神直接臣服！！！","作为全局胜者（在最终决战中获胜）会获得终局王者印记一枚，该印记任何时候，任何模式，永久标记，永久生效！！！","玩家撤退成功，将丢入弃牌区，且视为直接战死！！！"],"a":3,"d":"core-001","an":"e49","k":"body","x":"出自《机制介绍》"},{"q":"「4.巳蛇」出自哪一篇？","o":["第一期：除魔卫道","第十期：新世纪~未来纪元","第六期：宇宙原理","第十二期：十二生肖"],"a":3,"d":"m1-011","an":"e7","k":"src","x":"原文：《第十二期：十二生肖》"},{"q":"「28.水瓶座」的效果是？","o":["收取对方精灵，仅1次使用机会","抽神兽×2，1次或者起二张牌/或者获1技能卡","抵挡一次伤害并增加一个护盾","存活时，所有人2vs2"],"a":1,"d":"m2-004","an":"e75","k":"body","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「②圣洁领域∽神技」的效果是？","o":["获得一次重生满战，满增益效果，可刷新一次阶级，可刷新我方战败前所有技能卡效果。","本场每献祭一只精灵，便可直接成功一万。","本场每献祭一只精灵，便可复活我方一只精灵恢复满血满战该献祭还可抵挡一次死亡效果（即可以抵挡神威，弱抗，攻击），不限次数。","本场无视所有级别攻击。"],"a":0,"d":"m3-001","an":"e114","k":"body","x":"出自《精灵阶级第一章》"},{"q":"效果：「濒危时，增加一个护盾，并令与对方 同级别的精灵除自己外都下场」\n这是哪一张？","o":["9.横扫千军","6.判官令/阎罗令","11.冰川怒","免疫"],"a":2,"d":"m1-020","an":"e35","k":"name","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「24.天蝎座」的效果是？","o":["献祭五只精灵，本场直接获胜","可重抽神兽或重获技能卡或重置精灵1次使用机会，视情况而定。","具有可抢夺性质，可以击已死亡精灵。 当我方攻击值总和≥死亡精灵血值，则可获得。","所有人额外获一张技能卡"],"a":1,"d":"m2-004","an":"e71","k":"body","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「第一组：斩神联动」出自哪一篇？","o":["第十模式：帝关之战","模式总介绍","第十一模式：诸神愚戏","第八模式：创世纪~神器之战"],"a":3,"d":"m2-004","an":"e17","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"效果：「由机制统领六大模块，分别是：技能卡阶级，模式玩法，精灵阶级，更新，优调，玩法规则。」\n这是哪一张？","o":["机制五十九：机制限定一一一一终局王者印记","机制八：关于游戏框架","机制五十七：机制限定-------神威","机制五十六：机制限定----一裁终局"],"a":1,"d":"core-001","an":"e37","k":"name","x":"出自《机制介绍》"},{"q":"效果：「作为全局胜者（在最终决战中获胜）会获得终局王者印记一枚，该印记任何时候，任何模式，永久标记，永久生效！！！」\n这是哪一张？","o":["机制五十五：机制限定----战至终章","机制八：关于游戏框架","机制五十九：机制限定一一一一终局王者印记","机制五十六：机制限定----一裁终局"],"a":2,"d":"core-001","an":"e53","k":"name","x":"出自《机制介绍》"},{"q":"「（2）阳之极」的效果是？","o":["当集齐15张神兽级别及以上的精灵+一位一级神+一位圣兽时，可进行如下2选1： ①焚灭所有玩家手牌，本局直接获胜。 ②焚灭起牌区与神兽区，直接开启决战。","每有人使用技能卡时，我方需要献祭3只精灵。 当七层印记叠满，获得奖励：2只神兽+5张牌。","当有人使用技能卡后，该玩家需要献祭1只精灵。","当有人使用技能卡时，该玩家需要献祭2只精灵。"],"a":0,"d":"m1-008","an":"e8","k":"body","x":"出自《第九期：九妖王归位》"},{"q":"「①抽神兽机制调改」的效果是？","o":["掷骰子后自行扩大倍数，抽取神兽区对应位置精灵(扩大倍数在神兽区可数范围内)","太初之时，混沌黑暗，以光明显现， 大道初立，是为正道。","第一代版本：除魔卫道、庆牛年","处理一直以来未解决的神兽机制，开创新模式以适配完善“终决”弊端，创造新型强度技能卡。 完善三大机制：模式决战、技能威望、神兽威望"],"a":0,"d":"core-003","an":"e98","k":"body","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"效果：「抽神兽×2，1次或者起二张牌/或者获1技能卡」\n这是哪一张？","o":["37.星系","26.天秤座","19.摩羯座","28.水瓶座"],"a":3,"d":"m2-004","an":"e75","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「5.兽权卡」出自哪一篇？","o":["技能卡阶级第一章","第一期：除魔卫道","第三十期：幻梦游园：联动梦幻西游","第三十六期：守望新星~新生气象"],"a":1,"d":"m1-002","an":"e7","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"「②钢刃冲杀」出自哪一篇？","o":["第三期：五行元素","第十期：新世纪~未来纪元","第三十四期：终战之巅","第一期：除魔卫道"],"a":0,"d":"m1-004","an":"e14","k":"src","x":"原文：《第三期：五行元素》"},{"q":"「26.天秤座」的效果是？","o":["抵挡一次伤害并增加一个护盾","所有玩家均只有1万血","收取对方精灵，仅1次使用机会","当我方血值高于对方时，可一击必杀"],"a":3,"d":"m2-004","an":"e73","k":"body","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「2.幻影卡」的效果是？","o":["本回合内结束任意攻击，三回合后再次现身。","本次出使神奇宝贝被打败后满血复活，并以一千暴击率进行攻击。","本回合无视对方攻击一次，从神兽区召唤助阵（有阶级）。","①增加技能卡使用数量 ②无视所有技能卡本回合"],"a":1,"d":"m1-002","an":"e4","k":"body","x":"出自《第一期：除魔卫道》"},{"q":"「㉙睚眦」的效果是？","o":["本场玩家上场的精灵，当一位玩家上场为神级，其余玩家上场的精灵均为神兽级别及以上级别的时候，则该神级精灵，无论是获胜还是战败，均只剩一次使用机会。","本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。","每次伤害无视护盾，本场伤害X2。","对同系一击必杀，对异系伤害x2"],"a":2,"d":"m2-006","an":"e98","k":"body","x":"出自《第十模式：帝关之战》"},{"q":"效果：「本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。」\n这是哪一张？","o":["第一组：完美世界联动","真伤，对精灵进行伤害加成","㉛狻猊","㉚囚牛"],"a":2,"d":"m2-006","an":"e100","k":"name","x":"出自《第十模式：帝关之战》"},{"q":"效果：「本场玩家上场的精灵，当一位玩家上场为神级，其余玩家上场的精灵均为神兽级别及以上级别的时候，则该神级精灵，无论是获胜还是战败，均只剩一次使用机会。」\n这是哪一张？","o":["㉚囚牛","㉙睚眦","20.神级精灵被限制情况","真伤，对精灵进行伤害加成"],"a":2,"d":"m2-006","an":"e35","k":"name","x":"出自《第十模式：帝关之战》"},{"q":"效果：「献祭五只精灵，本场直接获胜」\n这是哪一张？","o":["29.白羊座","20.双子座","24.天蝎座","37.星系"],"a":3,"d":"m2-004","an":"e86","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"效果：「标记其余人，通过掷骰子决定其 本场共可行动次数，次数达到后 将视为不可生还，同时无法行动」\n这是哪一张？","o":["6.判官令/阎罗令","11.冰川怒","5.龙腾","指导"],"a":0,"d":"m1-020","an":"e27","k":"name","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「6.天蝎座」的效果是？","o":["收取对方精灵，仅1次使用机会","抽神兽×2，1次或者起二张牌/或者获1技能卡","可重抽神兽或重获技能卡或重置精灵1次使用机会，视情况而定。","所有玩家均只有1万血"],"a":2,"d":"m1-012","an":"e6","k":"body","x":"出自《第十三期：十二星座》"},{"q":"「9.贼卡」的效果是？","o":["捕捉神及以下，三次。","从起牌区召唤一张助战。","其余人各起一张牌，使用者弃牌一张牌。","免疫对方技能卡一次。"],"a":2,"d":"m1-002","an":"e11","k":"body","x":"出自《第一期：除魔卫道》"},{"q":"效果：「当集齐15张神兽级别及以上的精灵+一位一级神+一位圣兽时，可进行如下2选1： ①焚灭所有玩家手牌，本局直接获胜。 ②焚灭起牌区与神兽区，直接开启决战。」\n这是哪一张？","o":["第一，二，三层","（1）灭妖神火","（2）阳之极","（一），诛仙"],"a":2,"d":"m1-008","an":"e8","k":"name","x":"出自《第九期：九妖王归位》"},{"q":"效果：「先起三张，看后放回，若败则起另外三张」\n这是哪一张？","o":["4.巳蛇","6.申猴","2.辰龙","8.酉鸡"],"a":3,"d":"m1-011","an":"e11","k":"name","x":"出自《第十二期：十二生肖》"},{"q":"「第一域」出自哪一篇？","o":["第三十期：幻梦游园：联动梦幻西游","第一期：除魔卫道","第十期：新世纪~未来纪元","第十一期：雾山五行"],"a":3,"d":"m1-010","an":"e10","k":"src","x":"原文：《第十一期：雾山五行》"},{"q":"「58.戌狗」的效果是？","o":["恐惧：令任意玩家停止行动、不可行动、不可用技能一次。","受到致命伤害后，我方精灵进入2回合涅槃状态。两回合后该精灵对全体在场精灵，造成群攻九千，该效果持续至本场结束。我方刚才的精灵丢入弃牌区，本场结束获得3张牌。","增加1万血值或者增加1万攻击。","可收取局内已阵亡精灵，获一次使用机会"],"a":2,"d":"m2-005","an":"e168","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"效果：「令普通精灵和三级神直接臣服！！！」\n这是哪一张？","o":["机制五十六：机制限定----一裁终局","机制五十七：机制限定-------神威","机制八：关于游戏框架","机制五十五：机制限定----战至终章"],"a":1,"d":"core-001","an":"e51","k":"name","x":"出自《机制介绍》"},{"q":"效果：「满血时，血值×2，残血或阵亡时仅增1倍血」\n这是哪一张？","o":["第一组：灵兽宫·六妖王","48.辰龙","52.申猴","54.酉鸡"],"a":2,"d":"m2-005","an":"e162","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"「第一组：斩神联动」的效果是？","o":["所有玩家均只有1万血","抽神兽×2，1次或者起二张牌/或者获1技能卡","每献祭三只精灵，打出一击必杀一次。每次增加2只精灵","（这里说一下禁物，神物，神技，超高危，神墟等同于活动级，部分神墟有特殊说明除外，王墟一般是妖王级）"],"a":3,"d":"m2-004","an":"e17","k":"body","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「第四，五层」的效果是？","o":["当有人使用技能卡时，该玩家需要献祭2只精灵。","每有人使用技能卡时，我方需要献祭3只精灵。 当七层印记叠满，获得奖励：2只神兽+5张牌。","当集齐15张神兽级别及以上的精灵+一位一级神+一位圣兽时，可进行如下2选1： ①焚灭所有玩家手牌，本局直接获胜。 ②焚灭起牌区与神兽区，直接开启决战。","共七层印记，每叠加一层需要完成对应需求。 第每层印记对应第每张技能卡，从获得该妖神时诛仙自动触发。 全场参与。"],"a":0,"d":"m1-008","an":"e34","k":"body","x":"出自《第九期：九妖王归位》"},{"q":"「9.金牛座」的效果是？","o":["可重抽神兽或重获技能卡或重置精灵1次使用机会，视情况而定。","存活时，所有人2vs2","反伤1次，我方受伤为0，以自身血值反伤","收取对方精灵，仅1次使用机会"],"a":2,"d":"m1-012","an":"e9","k":"body","x":"出自《第十三期：十二星座》"},{"q":"「9.贼卡」出自哪一篇？","o":["第一期：除魔卫道","第三十一期：龙生九子联动","第三十八期：完美世界~帝关之战","第二十九期：幻世阅书~终末"],"a":0,"d":"m1-002","an":"e11","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"效果：「每次伤害无视护盾，本场伤害X2。」\n这是哪一张？","o":["㉙睚眦","㉚囚牛","㉛狻猊","㉜霸下"],"a":0,"d":"m2-006","an":"e98","k":"name","x":"出自《第十模式：帝关之战》"},{"q":"「6.判官令/阎罗令」的效果是？","o":["每次攻击附带全场每人的50%","标记其余人，通过掷骰子决定其 本场共可行动次数，次数达到后 将视为不可生还，同时无法行动","①敌方本回合不可行动 ②敌方下回合不可行动 ③敌方本场不可使用技能卡 三选一。","①死亡后满血并刷新阶级 ②如贼卡、神威、弱抗等无效 ③免疫80%技能卡 ④本回合存在直接结束时、撤退时 计为我方获胜"],"a":1,"d":"m1-020","an":"e27","k":"body","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「第一组：灵兽宫·六妖王」出自哪一篇？","o":["第九模式：觉醒之战","第十模式：帝关之战","第四模式：混沌之战","第一模式：联动玩法"],"a":0,"d":"m2-005","an":"e15","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"「12.巨蟹座」出自哪一篇？","o":["第十三期：十二星座","第四十期：铠甲勇士~铠传","第九期：九妖王归位","技能卡阶级第一章"],"a":0,"d":"m1-012","an":"e12","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"「52.申猴」出自哪一篇？","o":["第四模式：混沌之战","第八模式：创世纪~神器之战","第九模式：觉醒之战","关于26年专属年卡和限定年卡的额外说明"],"a":2,"d":"m2-005","an":"e162","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"「6.狻猊」出自哪一篇？","o":["第三期：五行元素","第二十二期：星海探梦","第三十一期：龙生九子联动","第十三期：十二星座"],"a":2,"d":"m1-021","an":"e24","k":"src","x":"原文：《第三十一期：龙生九子联动》"},{"q":"「第六，七层」的效果是？","o":["每有人使用技能卡时，我方需要献祭3只精灵。 当七层印记叠满，获得奖励：2只神兽+5张牌。","该技能，可以焚灭与夺取本场此前出现的所有精灵与特权之下的技能卡。 包括死亡精灵与已经使用的技能卡。我方出战的精灵需要丢入弃牌区。","当有人使用技能卡时，该玩家需要献祭2只精灵。","当有人使用技能卡后，该玩家需要献祭1只精灵。"],"a":0,"d":"m1-008","an":"e35","k":"body","x":"出自《第九期：九妖王归位》"},{"q":"效果：「天启降临·神界宙轨2023年4月28日 下午3点」\n这是哪一张？","o":["①抽神兽机制调改","太初无极","⑤版本介绍","天启系列"],"a":3,"d":"core-003","an":"e150","k":"name","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"效果：「恐惧：令任意玩家停止行动、不可行动、不可用技能一次。」\n这是哪一张？","o":["54.酉鸡","51.亥猪","50.巳蛇","52.申猴"],"a":2,"d":"m2-005","an":"e160","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"「5.龙腾」的效果是？","o":["每次攻击附带全场每人的50%","①死亡后满血并刷新阶级 ②如贼卡、神威、弱抗等无效 ③免疫80%技能卡 ④本回合存在直接结束时、撤退时 计为我方获胜","佩戴给龙属性精灵时，将加持免疫弱抗， 阶级伤害无效、一击必杀无效， 同时血攻防×2","①抽神兽时三选一 ②起牌时九选三 二选一"],"a":2,"d":"m1-020","an":"e26","k":"body","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「㉚囚牛」出自哪一篇？","o":["第十模式：帝关之战","第九模式：觉醒之战","关于26年专属年卡和限定年卡的额外说明","第四模式：混沌之战"],"a":0,"d":"m2-006","an":"e99","k":"src","x":"原文：《第十模式：帝关之战》"},{"q":"「7.霸下」的效果是？","o":["本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。","对同系一击必杀，对异系伤害x2","每次伤害无视护盾，本场伤害X2。","满血时用获得2个护盾，残血时用获得1个护盾和一次行动。"],"a":3,"d":"m1-021","an":"e25","k":"body","x":"出自《第三十一期：龙生九子联动》"},{"q":"「2.虫洞空间」出自哪一篇？","o":["技能卡阶级第一章","第十期：新世纪~未来纪元","第七期：轮回转世~再续前缘","第四期：幻年降临~2020"],"a":1,"d":"m1-009","an":"e2","k":"src","x":"原文：《第十期：新世纪~未来纪元》"},{"q":"「该活动为系列活动」出自哪一篇？","o":["第二十六期：隐曜洞徽","第四十期：铠甲勇士~铠传","第十一期：雾山五行","第三十七期：斩神联动"],"a":0,"d":"m1-016","an":"e38","k":"src","x":"原文：《第二十六期：隐曜洞徽》"},{"q":"「㉚囚牛」的效果是？","o":["对同系一击必杀，对异系伤害x2","①当前攻击高于我方 ②当前血值高于我方 ③当前阶级高于我方 每场只能选一或二，该判定结果为必杀。","①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级","①当前血值低于我方 ②当前攻击低于我方 ③当前阶级低于我方"],"a":0,"d":"m2-006","an":"e99","k":"body","x":"出自《第十模式：帝关之战》"},{"q":"「㉛狻猊」出自哪一篇？","o":["第八模式：创世纪~神器之战","第十模式：帝关之战","第一模式：联动玩法","第九模式：觉醒之战"],"a":1,"d":"m2-006","an":"e100","k":"src","x":"原文：《第十模式：帝关之战》"},{"q":"「9.该模式共2个牌区」出自哪一篇？","o":["模式总介绍","第四模式：混沌之战","关于26年专属年卡和限定年卡的额外说明","第九模式：觉醒之战"],"a":1,"d":"m2-003","an":"e3","k":"src","x":"原文：《第四模式：混沌之战》"},{"q":"「11.该模式配置」出自哪一篇？","o":["第一模式：联动玩法","关于26年专属年卡和限定年卡的额外说明","第九模式：觉醒之战","第八模式：创世纪~神器之战"],"a":2,"d":"m2-005","an":"e12","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"「第四，五层」出自哪一篇？","o":["第四期：幻年降临~2020","第七期：轮回转世~再续前缘","第九期：九妖王归位","第三期：五行元素"],"a":2,"d":"m1-008","an":"e34","k":"src","x":"原文：《第九期：九妖王归位》"},{"q":"「机制八：关于游戏框架」的效果是？","o":["玩家撤退成功，将丢入弃牌区，且视为直接战死！！！","作为全局胜者（在最终决战中获胜）会获得终局王者印记一枚，该印记任何时候，任何模式，永久标记，永久生效！！！","令普通精灵和三级神直接臣服！！！","由机制统领六大模块，分别是：技能卡阶级，模式玩法，精灵阶级，更新，优调，玩法规则。"],"a":3,"d":"core-001","an":"e37","k":"body","x":"出自《机制介绍》"},{"q":"「51.亥猪」出自哪一篇？","o":["第十一模式：诸神愚戏","第十模式：帝关之战","第九模式：觉醒之战","第十二模式：铠甲勇士~铠传"],"a":2,"d":"m2-005","an":"e161","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"效果：「本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。」\n这是哪一张？","o":["4.睚眦","7.霸下","5.囚牛","6.狻猊"],"a":3,"d":"m1-021","an":"e24","k":"name","x":"出自《第三十一期：龙生九子联动》"},{"q":"「48.辰龙」出自哪一篇？","o":["第八模式：创世纪~神器之战","第十一模式：诸神愚戏","第一模式：联动玩法","第九模式：觉醒之战"],"a":3,"d":"m2-005","an":"e158","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"「7.子鼠」的效果是？","o":["在行动时，献祭同系精灵2只，即可扩大一倍伤害。","增加1万血值或者增加1万攻击。 备案：该版本为第六版，为最新版本。始创于21年年末，和12星座一样为庆祝22年做准备。","恐惧：令任意玩家停止行动、不可行动、不可用技能一次。","先起三张，看后放回，若败则起另外三张"],"a":0,"d":"m1-011","an":"e10","k":"body","x":"出自《第十二期：十二生肖》"},{"q":"「53.子鼠」的效果是？","o":["1.青龙之力：妖王（东方青龙木）","除青龙之力、麒麟瑞兽两妖王之外，在其它妖王领域之内（四妖王）若存在逃跑玩家，则该妖王次数重置。","在行动时，献祭同系精灵2只，即可扩大一倍伤害。","满血时，血值×2，残血或阵亡时仅增1倍血"],"a":2,"d":"m2-005","an":"e163","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"「①钢铁铸造」出自哪一篇？","o":["第四十期：铠甲勇士~铠传","第三期：五行元素","第三十八期：完美世界~帝关之战","第三十九期：诸神愚戏"],"a":1,"d":"m1-004","an":"e13","k":"src","x":"原文：《第三期：五行元素》"},{"q":"「第五级：常规级」出自哪一篇？","o":["技能卡阶级第一章","第六期：宇宙原理","关于26年专属年卡和限定年卡的额外说明","第三十六期：守望新星~新生气象"],"a":0,"d":"m1-001","an":"e15","k":"src","x":"原文：《技能卡阶级第一章》"},{"q":"效果：「无神威，无弱抗，所有精灵无限叠加，所有阶级均生效，大部分技能卡均有效。 无手牌者战死，最后在场者为终局胜者，获终局王者印记。」\n这是哪一张？","o":["10.最终决战模式","第二组：隐曜逆元+隐曜洞徽+幻世阅书","28.闪现活复甲：活动级","9.该模式共2个牌区"],"a":0,"d":"m2-003","an":"e4","k":"name","x":"出自《第四模式：混沌之战》"},{"q":"「太初无极」的效果是？","o":["太初之时，混沌黑暗，以光明显现， 大道初立，是为正道。","掷骰子后自行扩大倍数，抽取神兽区对应位置精灵(扩大倍数在神兽区可数范围内)","处理一直以来未解决的神兽机制，开创新模式以适配完善“终决”弊端，创造新型强度技能卡。 完善三大机制：模式决战、技能威望、神兽威望","第一代版本：除魔卫道、庆牛年"],"a":0,"d":"core-003","an":"e143","k":"body","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"效果：「每有人使用技能卡时，我方需要献祭3只精灵。 当七层印记叠满，获得奖励：2只神兽+5张牌。」\n这是哪一张？","o":["（2）阳之极","第四，五层","（二），逆袭封神榜","第六，七层"],"a":3,"d":"m1-008","an":"e35","k":"name","x":"出自《第九期：九妖王归位》"},{"q":"「①创生本源∽神技」的效果是？","o":["可开启极巨化空间，其余玩家均拥有一次极具巨化效果。我方掷骰子决定，我方至少获得三次该效果。","本场每献祭一只精灵，便可复活我方一只精灵恢复满血满战该献祭还可抵挡一次死亡效果（即可以抵挡神威，弱抗，攻击），不限次数。","获得一次重生满战，满增益效果，可刷新一次阶级，可刷新我方战败前所有技能卡效果。","本场每献祭一只精灵，便可直接成功一万。"],"a":1,"d":"m3-001","an":"e101","k":"body","x":"出自《精灵阶级第一章》"},{"q":"效果：「先起三张，看后放回，若败则起另外三张」\n这是哪一张？","o":["52.申猴","第一组：灵兽宫·六妖王","50.巳蛇","54.酉鸡"],"a":3,"d":"m2-005","an":"e164","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"「㉜霸下」的效果是？","o":["满血时用获得2个护盾，残血时用获得1个护盾和一次行动。","①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级","本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。","①当前攻击高于我方 ②当前血值高于我方 ③当前阶级高于我方 每场只能选一或二，该判定结果为必杀。"],"a":0,"d":"m2-006","an":"e101","k":"body","x":"出自《第十模式：帝关之战》"},{"q":"效果：「本场每献祭一只精灵，便可复活我方一只精灵恢复满血满战该献祭还可抵挡一次死亡效果（即可以抵挡神威，弱抗，攻击），不限次数。」\n这是哪一张？","o":["②神罚效果∽神技","③三圣护体∽神技","①圣火领域∽神技","①创生本源∽神技"],"a":3,"d":"m3-001","an":"e101","k":"name","x":"出自《精灵阶级第一章》"},{"q":"「4.处女座」出自哪一篇？","o":["第十三期：十二星座","第三十二期：灵兽宫~珍宝秘笈","第十一期：雾山五行","第十期：新世纪~未来纪元"],"a":0,"d":"m1-012","an":"e4","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"效果：「恐惧：令任意玩家停止行动、不可行动、不可用技能一次。」\n这是哪一张？","o":["4.巳蛇","5.亥猪","12.戌狗","6.申猴"],"a":0,"d":"m1-011","an":"e7","k":"name","x":"出自《第十二期：十二生肖》"},{"q":"「12.戌狗」出自哪一篇？","o":["第二十九期：幻世阅书~终末","第十二期：十二生肖","第六期：宇宙原理","第二期：庆牛年~喜气冲天"],"a":1,"d":"m1-011","an":"e15","k":"src","x":"原文：《第十二期：十二生肖》"},{"q":"「第一，二，三层」的效果是？","o":["每有人使用技能卡时，我方需要献祭3只精灵。 当七层印记叠满，获得奖励：2只神兽+5张牌。","当有人使用技能卡后，该玩家需要献祭1只精灵。","共七层印记，每叠加一层需要完成对应需求。 第每层印记对应第每张技能卡，从获得该妖神时诛仙自动触发。 全场参与。","该技能，可以焚灭与夺取本场此前出现的所有精灵与特权之下的技能卡。 包括死亡精灵与已经使用的技能卡。我方出战的精灵需要丢入弃牌区。"],"a":1,"d":"m1-008","an":"e33","k":"body","x":"出自《第九期：九妖王归位》"},{"q":"「一、护魂」出自哪一篇？","o":["第九期：九妖王归位","第三十四期：终战之巅","第七期：轮回转世~再续前缘","第二十九期：幻世阅书~终末"],"a":1,"d":"m1-023","an":"e62","k":"src","x":"原文：《第三十四期：终战之巅》"},{"q":"「19.摩羯座」出自哪一篇？","o":["关于26年专属年卡和限定年卡的额外说明","第八模式：创世纪~神器之战","第一模式：联动玩法","第十一模式：诸神愚戏"],"a":1,"d":"m2-004","an":"e66","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「53.子鼠」出自哪一篇？","o":["第九模式：觉醒之战","第十二模式：铠甲勇士~铠传","第十模式：帝关之战","模式总介绍"],"a":0,"d":"m2-005","an":"e163","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"「11.该模式配置」的效果是？","o":["共有2次先行机会，每场仅一次。先行时若击杀一位玩家可起3张牌！","受到致命伤害后，我方精灵进入2回合涅槃状态。两回合后该精灵对全体在场精灵，造成群攻九千，该效果持续至本场结束。我方刚才的精灵丢入弃牌区，本场结束获得3张牌。","除青龙之力、麒麟瑞兽两妖王之外，在其它妖王领域之内（四妖王）若存在逃跑玩家，则该妖王次数重置。","先起三张，看后放回，若败则起另外三张"],"a":2,"d":"m2-005","an":"e12","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"「35.斗系」出自哪一篇？","o":["模式总介绍","第八模式：创世纪~神器之战","关于26年专属年卡和限定年卡的额外说明","第九模式：觉醒之战"],"a":1,"d":"m2-004","an":"e84","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「10.隐身卡」的效果是？","o":["①增加技能卡使用数量 ②无视所有技能卡本回合","本回合内结束任意攻击，三回合后再次现身。","本次出使神奇宝贝被打败后满血复活，并以一千暴击率进行攻击。","捕捉神及以下，三次。"],"a":1,"d":"m1-002","an":"e12","k":"body","x":"出自《第一期：除魔卫道》"},{"q":"效果：「本次出使神奇宝贝被打败后满血复活，并以一千暴击率进行攻击。」\n这是哪一张？","o":["7.幸运卡","2.幻影卡","8.保护卡","5.兽权卡"],"a":1,"d":"m1-002","an":"e4","k":"name","x":"出自《第一期：除魔卫道》"},{"q":"「4.超纪元·三十世纪」出自哪一篇？","o":["第二期：庆牛年~喜气冲天","第三十期：幻梦游园：联动梦幻西游","第二十八期：隐曜逆元","第十期：新世纪~未来纪元"],"a":3,"d":"m1-009","an":"e4","k":"src","x":"原文：《第十期：新世纪~未来纪元》"},{"q":"「51.亥猪」的效果是？","o":["满血时，血值×2，残血或阵亡时仅增1倍血","恐惧：令任意玩家停止行动、不可行动、不可用技能一次。","增加1万血值或者增加1万攻击。","可收取局内已阵亡精灵，获一次使用机会"],"a":3,"d":"m2-005","an":"e161","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"「5.决战阶段」出自哪一篇？","o":["第四模式：混沌之战","第九模式：觉醒之战","第十一模式：诸神愚戏","第八模式：创世纪~神器之战"],"a":2,"d":"m2-007","an":"e5","k":"src","x":"原文：《第十一模式：诸神愚戏》"},{"q":"「第一，二，三层」出自哪一篇？","o":["第七期：轮回转世~再续前缘","第十一期：雾山五行","第九期：九妖王归位","第三十二期：灵兽宫~珍宝秘笈"],"a":2,"d":"m1-008","an":"e33","k":"src","x":"原文：《第九期：九妖王归位》"},{"q":"「20.双子座」出自哪一篇？","o":["第十二模式：铠甲勇士~铠传","第九模式：觉醒之战","关于26年专属年卡和限定年卡的额外说明","第八模式：创世纪~神器之战"],"a":3,"d":"m2-004","an":"e67","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「29.白羊座」出自哪一篇？","o":["第十一模式：诸神愚戏","第四模式：混沌之战","第八模式：创世纪~神器之战","第一模式：联动玩法"],"a":2,"d":"m2-004","an":"e76","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「第二级：妖王级」出自哪一篇？","o":["技能卡阶级第一章","第六期：宇宙原理","第二十五期：祈愿护梦~庆兔年","第七期：轮回转世~再续前缘"],"a":0,"d":"m1-001","an":"e6","k":"src","x":"原文：《技能卡阶级第一章》"},{"q":"「3.抗疫情卡」出自哪一篇？","o":["第十期：新世纪~未来纪元","第十二期：十二生肖","第一期：除魔卫道","第二十一期：征天揽星"],"a":2,"d":"m1-002","an":"e5","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"「9.金牛座」出自哪一篇？","o":["第二十九期：幻世阅书~终末","第三十六期：守望新星~新生气象","第十三期：十二星座","第十期：新世纪~未来纪元"],"a":2,"d":"m1-012","an":"e9","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"效果：「增加1万血值或者增加1万攻击。」\n这是哪一张？","o":["48.辰龙","第一组：灵兽宫·六妖王","58.戌狗","50.巳蛇"],"a":2,"d":"m2-005","an":"e168","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"效果：「抵挡一次伤害并增加一个护盾」\n这是哪一张？","o":["22.处女座","24.天蝎座","第一组：斩神联动","30.巨蟹座"],"a":0,"d":"m2-004","an":"e69","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"效果：「除青龙之力、麒麟瑞兽两妖王之外，在其它妖王领域之内（四妖王）若存在逃跑玩家，则该妖王次数重置。」\n这是哪一张？","o":["53.子鼠","51.亥猪","7.每牌区玩家精灵手牌上限","11.该模式配置"],"a":3,"d":"m2-005","an":"e12","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"「3.抗疫情卡」的效果是？","o":["其余人各起一张牌，使用者弃牌一张牌。","捕捉神及以下，三次。","从起牌区召唤一张助战。","本回合无视对方攻击一次，从神兽区召唤助阵（有阶级）。"],"a":3,"d":"m1-002","an":"e5","k":"body","x":"出自《第一期：除魔卫道》"},{"q":"「18.猎铠鹰帅」出自哪一篇？","o":["第十二模式：铠甲勇士~铠传","第九模式：觉醒之战","第十模式：帝关之战","模式总介绍"],"a":0,"d":"m2-008","an":"e88","k":"src","x":"原文：《第十二模式：铠甲勇士~铠传》"},{"q":"「4.晋神之路额外回合」出自哪一篇？","o":["第十一模式：诸神愚戏","第十二模式：铠甲勇士~铠传","第一模式：联动玩法","第十模式：帝关之战"],"a":0,"d":"m2-007","an":"e4","k":"src","x":"原文：《第十一模式：诸神愚戏》"},{"q":"「35.斗系」的效果是？","o":["（这里说一下禁物，神物，神技，超高危，神墟等同于活动级，部分神墟有特殊说明除外，王墟一般是妖王级）","每献祭三只精灵，打出一击必杀一次。每次增加2只精灵","献祭五只精灵，本场直接获胜","具有可抢夺性质，可以击已死亡精灵。 当我方攻击值总和≥死亡精灵血值，则可获得。"],"a":1,"d":"m2-004","an":"e84","k":"body","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「㉙睚眦」出自哪一篇？","o":["第十模式：帝关之战","模式总介绍","第八模式：创世纪~神器之战","第四模式：混沌之战"],"a":0,"d":"m2-006","an":"e98","k":"src","x":"原文：《第十模式：帝关之战》"},{"q":"「8.天秤座」出自哪一篇？","o":["第二十二期：星海探梦","第十三期：十二星座","第二十七期：天启降临~神界宙轨","第二十八期：隐曜逆元"],"a":1,"d":"m1-012","an":"e8","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"「㉛狻猊」的效果是？","o":["①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级","①当前血值低于我方 ②当前攻击低于我方 ③当前阶级低于我方","本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。","每次伤害无视护盾，本场伤害X2。"],"a":2,"d":"m2-006","an":"e100","k":"body","x":"出自《第十模式：帝关之战》"},{"q":"效果：「在行动时，献祭同系精灵2只，即可扩大一倍伤害。」\n这是哪一张？","o":["7.子鼠","5.亥猪","4.巳蛇","2.辰龙"],"a":0,"d":"m1-011","an":"e10","k":"name","x":"出自《第十二期：十二生肖》"},{"q":"效果：「本场每献祭一只精灵，便可直接成功一万。」\n这是哪一张？","o":["①圣火领域∽神技","异次元空间∽神技","②神罚效果∽神技","五，极巨化之神：无极汰那"],"a":2,"d":"m3-001","an":"e102","k":"name","x":"出自《精灵阶级第一章》"},{"q":"效果：「获得一次重生满战，满增益效果，可刷新一次阶级，可刷新我方战败前所有技能卡效果。」\n这是哪一张？","o":["②神罚效果∽神技","异次元空间∽神技","②圣洁领域∽神技","极巨化效果"],"a":2,"d":"m3-001","an":"e114","k":"name","x":"出自《精灵阶级第一章》"},{"q":"「58.戌狗」出自哪一篇？","o":["第九模式：觉醒之战","第八模式：创世纪~神器之战","第十二模式：铠甲勇士~铠传","第一模式：联动玩法"],"a":0,"d":"m2-005","an":"e168","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"「29.白羊座」的效果是？","o":["收取对方精灵，仅1次使用机会","抵挡一次伤害并增加一个护盾","献祭五只精灵，本场直接获胜","具有可抢夺性质，可以击已死亡精灵。 当我方攻击值总和≥死亡精灵血值，则可获得。"],"a":0,"d":"m2-004","an":"e76","k":"body","x":"出自《第八模式：创世纪~神器之战》"},{"q":"效果：「可收取局内已阵亡精灵，获一次使用机会」\n这是哪一张？","o":["51.亥猪","第一组：灵兽宫·六妖王","48.辰龙","11.该模式配置"],"a":0,"d":"m2-005","an":"e161","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"「第二组：隐曜逆元+隐曜洞徽+幻世阅书」的效果是？","o":["无神威，无弱抗，所有精灵无限叠加，所有阶级均生效，大部分技能卡均有效。 无手牌者战死，最后在场者为终局胜者，获终局王者印记。","第一牌区末：手牌上限20张。 第二牌区末：手牌上限20张。","①死亡后用：增1万血+1万攻 ②死亡前用：免疫本次行动，直接撤退并重置为1次使用机会。","5.全场嘲讽之力：活动级 本场所有伤害，每次最多仅造成我方血值的33%。"],"a":3,"d":"m2-003","an":"e28","k":"body","x":"出自《第四模式：混沌之战》"},{"q":"「免疫」出自哪一篇？","o":["第三十四期：终战之巅","第四期：幻年降临~2020","第三十期：幻梦游园：联动梦幻西游","第四十期：铠甲勇士~铠传"],"a":2,"d":"m1-020","an":"e42","k":"src","x":"原文：《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「27.金牛座」出自哪一篇？","o":["关于26年专属年卡和限定年卡的额外说明","第十二模式：铠甲勇士~铠传","第八模式：创世纪~神器之战","第一模式：联动玩法"],"a":2,"d":"m2-004","an":"e74","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「6.申猴」的效果是？","o":["在行动时，献祭同系精灵2只，即可扩大一倍伤害。","满血时，血值×2，残血或阵亡时仅增1倍血","先起三张，看后放回，若败则起另外三张","恐惧：令任意玩家停止行动、不可行动、不可用技能一次。"],"a":1,"d":"m1-011","an":"e9","k":"body","x":"出自《第十二期：十二生肖》"},{"q":"效果：「增加1万血值或者增加1万攻击。 备案：该版本为第六版，为最新版本。始创于21年年末，和12星座一样为庆祝22年做准备。」\n这是哪一张？","o":["6.申猴","4.巳蛇","12.戌狗","5.亥猪"],"a":2,"d":"m1-011","an":"e15","k":"name","x":"出自《第十二期：十二生肖》"},{"q":"「第一组：完美世界联动」出自哪一篇？","o":["模式总介绍","第一模式：联动玩法","第十模式：帝关之战","第四模式：混沌之战"],"a":2,"d":"m2-006","an":"e38","k":"src","x":"原文：《第十模式：帝关之战》"},{"q":"「第六，七层」出自哪一篇？","o":["第九期：九妖王归位","技能卡阶级第一章","第三十八期：完美世界~帝关之战","第二十九期：幻世阅书~终末"],"a":0,"d":"m1-008","an":"e35","k":"src","x":"原文：《第九期：九妖王归位》"},{"q":"「机制五十九：机制限定一一一一终局王者印记」的效果是？","o":["作为全局胜者（在最终决战中获胜）会获得终局王者印记一枚，该印记任何时候，任何模式，永久标记，永久生效！！！","任何技能卡都不会被抵消，不会被随意丢弃，不会丧失技能。","由机制统领六大模块，分别是：技能卡阶级，模式玩法，精灵阶级，更新，优调，玩法规则。","当上场战斗结束，下场战斗已经开始时，上场所出现的一切错误均有效，无法补救，无法倒退！！！"],"a":0,"d":"core-001","an":"e53","k":"body","x":"出自《机制介绍》"},{"q":"「3.每牌区末开启两场晋神之路」出自哪一篇？","o":["关于26年专属年卡和限定年卡的额外说明","第十二模式：铠甲勇士~铠传","第十模式：帝关之战","第十一模式：诸神愚戏"],"a":3,"d":"m2-007","an":"e3","k":"src","x":"原文：《第十一模式：诸神愚戏》"},{"q":"效果：「收取对方精灵，仅1次使用机会」\n这是哪一张？","o":["8.天秤座","10.水瓶座","1.摩羯座","11.白羊座"],"a":3,"d":"m1-012","an":"e11","k":"name","x":"出自《第十三期：十二星座》"},{"q":"「极巨化效果」的效果是？","o":["本场每献祭一只精灵，便可复活我方一只精灵恢复满血满战该献祭还可抵挡一次死亡效果（即可以抵挡神威，弱抗，攻击），不限次数。","战斗中可派出所有同系精灵进行依次叠加，该效果无视神威，弱抗。若胜则均返还，返还精灵均只剩一次使用机会。若败，则助战精灵丢入弃牌区，并获得对应张数n张牌。","获得一次重生满战，满增益效果，可刷新一次阶级，可刷新我方战败前所有技能卡效果。","令每之极巨化精灵(Vmax)的攻击和血值额外加4万;每只极巨化精灵之间无弱抗影响，且不受非极巨化精灵弱抗影响，极巨化效果同样对迦勒尔精灵生效。"],"a":3,"d":"m3-001","an":"e109","k":"body","x":"出自《精灵阶级第一章》"},{"q":"「⑤版本介绍」的效果是？","o":["掷骰子后自行扩大倍数，抽取神兽区对应位置精灵(扩大倍数在神兽区可数范围内)","出场的一回合免疫伤害、阶级、负面效果 并持续免疫弱抗，但我方血值与光之巨人血值没有关联，只计总伤害。 ③能量石专门抽神兽，光之石专门抽奥特曼，奥特曼位于英雄","第一代版本：除魔卫道、庆牛年","处理一直以来未解决的神兽机制，开创新模式以适配完善“终决”弊端，创造新型强度技能卡。 完善三大机制：模式决战、技能威望、神兽威望"],"a":2,"d":"core-003","an":"e62","k":"body","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"「11.白羊座」出自哪一篇？","o":["第三十六期：守望新星~新生气象","第十三期：十二星座","第三十七期：斩神联动","第三十二期：灵兽宫~珍宝秘笈"],"a":1,"d":"m1-012","an":"e11","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"「祈愿值获取」出自哪一篇？","o":["技能卡阶级第一章","第二期：庆牛年~喜气冲天","第二十五期：祈愿护梦~庆兔年","第四期：幻年降临~2020"],"a":2,"d":"m1-015","an":"e15","k":"src","x":"原文：《第二十五期：祈愿护梦~庆兔年》"},{"q":"效果：「每献祭三只精灵，打出一击必杀一次。每次增加2只精灵」\n这是哪一张？","o":["35.斗系","26.天秤座","27.金牛座","24.天蝎座"],"a":0,"d":"m2-004","an":"e84","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「机制五十一：机制限定-----技能毕用」的效果是？","o":["令普通精灵和三级神直接臣服！！！","由机制统领六大模块，分别是：技能卡阶级，模式玩法，精灵阶级，更新，优调，玩法规则。","作为全局胜者（在最终决战中获胜）会获得终局王者印记一枚，该印记任何时候，任何模式，永久标记，永久生效！！！","任何技能卡都不会被抵消，不会被随意丢弃，不会丧失技能。"],"a":3,"d":"core-001","an":"e38","k":"body","x":"出自《机制介绍》"},{"q":"效果：「任何技能卡都不会被抵消，不会被随意丢弃，不会丧失技能。」\n这是哪一张？","o":["机制五十九：机制限定一一一一终局王者印记","机制五十七：机制限定-------神威","机制五十一：机制限定-----技能毕用","机制五十六：机制限定----一裁终局"],"a":2,"d":"core-001","an":"e38","k":"name","x":"出自《机制介绍》"},{"q":"「6.狻猊」的效果是？","o":["对同系一击必杀，对异系伤害x2","满血时用获得2个护盾，残血时用获得1个护盾和一次行动。","本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。","每次伤害无视护盾，本场伤害X2。"],"a":2,"d":"m1-021","an":"e24","k":"body","x":"出自《第三十一期：龙生九子联动》"},{"q":"「28.闪现活复甲：活动级」的效果是？","o":["①死亡后用：增1万血+1万攻 ②死亡前用：免疫本次行动，直接撤退并重置为1次使用机会。","无神威，无弱抗，所有精灵无限叠加，所有阶级均生效，大部分技能卡均有效。 无手牌者战死，最后在场者为终局胜者，获终局王者印记。","5.全场嘲讽之力：活动级 本场所有伤害，每次最多仅造成我方血值的33%。","第一牌区末：手牌上限20张。 第二牌区末：手牌上限20张。"],"a":0,"d":"m2-003","an":"e89","k":"body","x":"出自《第四模式：混沌之战》"},{"q":"效果：「抵挡一次伤害并增加一个护盾」\n这是哪一张？","o":["8.天秤座","4.处女座","12.巨蟹座","6.天蝎座"],"a":1,"d":"m1-012","an":"e4","k":"name","x":"出自《第十三期：十二星座》"},{"q":"「五，极巨化之神：无极汰那」的效果是？","o":["令每之极巨化精灵(Vmax)的攻击和血值额外加4万;每只极巨化精灵之间无弱抗影响，且不受非极巨化精灵弱抗影响，极巨化效果同样对迦勒尔精灵生效。","无视神级，圣兽效果与阶级行动拥有一次一战之力。","拥有三次各属性征调机会，本场可征调一次水系火系电系，为我方出战精灵助战，战斗结束后征调精灵均丢入弃牌区，征调精灵从我方手牌中打出。","可开启极巨化空间，其余玩家均拥有一次极具巨化效果。我方掷骰子决定，我方至少获得三次该效果。"],"a":3,"d":"m3-001","an":"e108","k":"body","x":"出自《精灵阶级第一章》"},{"q":"效果：「满血时用获得2个护盾，残血时用获得1个护盾和一次行动。」\n这是哪一张？","o":["7.霸下","6.狻猊","4.睚眦","5.囚牛"],"a":0,"d":"m1-021","an":"e25","k":"name","x":"出自《第三十一期：龙生九子联动》"},{"q":"「2.双子座」出自哪一篇？","o":["第三十九期：诸神愚戏","第十三期：十二星座","第一期：除魔卫道","第三期：五行元素"],"a":1,"d":"m1-012","an":"e2","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"效果：「在行动时，献祭同系精灵2只，即可扩大一倍伤害。」\n这是哪一张？","o":["7.每牌区玩家精灵手牌上限","53.子鼠","51.亥猪","48.辰龙"],"a":1,"d":"m2-005","an":"e163","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"「11.冰川怒」出自哪一篇？","o":["第三十一期：龙生九子联动","第三十期：幻梦游园：联动梦幻西游","第三期：五行元素","第四期：幻年降临~2020"],"a":1,"d":"m1-020","an":"e35","k":"src","x":"原文：《第三十期：幻梦游园：联动梦幻西游》"},{"q":"效果：「满血时用获得2个护盾，残血时用获得1个护盾和一次行动。」\n这是哪一张？","o":["第一组：完美世界联动","20.神级精灵被限制情况","㉛狻猊","㉜霸下"],"a":3,"d":"m2-006","an":"e101","k":"name","x":"出自《第十模式：帝关之战》"},{"q":"效果：「普通：+3000 阶级：+6000」\n这是哪一张？","o":["㉛狻猊","㉚囚牛","20.神级精灵被限制情况","真伤，对精灵进行伤害加成"],"a":3,"d":"m2-006","an":"e88","k":"name","x":"出自《第十模式：帝关之战》"},{"q":"「20.神级精灵被限制情况」的效果是？","o":["每次伤害无视护盾，本场伤害X2。","对同系一击必杀，对异系伤害x2","①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级","本场玩家上场的精灵，当一位玩家上场为神级，其余玩家上场的精灵均为神兽级别及以上级别的时候，则该神级精灵，无论是获胜还是战败，均只剩一次使用机会。"],"a":3,"d":"m2-006","an":"e35","k":"body","x":"出自《第十模式：帝关之战》"},{"q":"「踏雪寻梅」出自哪一篇？","o":["第十三期：十二星座","第十一期：雾山五行","第二十五期：祈愿护梦~庆兔年","第十期：新世纪~未来纪元"],"a":2,"d":"m1-015","an":"e39","k":"src","x":"原文：《第二十五期：祈愿护梦~庆兔年》"},{"q":"效果：「当有人使用技能卡时，该玩家需要献祭2只精灵。」\n这是哪一张？","o":["第四，五层","（一），诛仙","（2）阳之极","（二），逆袭封神榜"],"a":0,"d":"m1-008","an":"e34","k":"name","x":"出自《第九期：九妖王归位》"},{"q":"「免疫」的效果是？","o":["濒危时，增加一个护盾，并令与对方 同级别的精灵除自己外都下场","①抽神兽时三选一 ②起牌时九选三 二选一","①死亡 ②控制、强制施实 ③技能卡 ④结束事件","佩戴给龙属性精灵时，将加持免疫弱抗， 阶级伤害无效、一击必杀无效， 同时血攻防×2"],"a":2,"d":"m1-020","an":"e42","k":"body","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「22.处女座」出自哪一篇？","o":["第十一模式：诸神愚戏","第八模式：创世纪~神器之战","第十模式：帝关之战","第四模式：混沌之战"],"a":1,"d":"m2-004","an":"e69","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「7.每牌区玩家精灵手牌上限」的效果是？","o":["第一区：40张；第二区：30张；第三区：20张","复活，并持续2万暴击","恢复一半血，并获一个护盾","可收取局内已阵亡精灵，获一次使用机会"],"a":0,"d":"m2-005","an":"e5","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"「指导」出自哪一篇？","o":["关于26年专属年卡和限定年卡的额外说明","第三十期：幻梦游园：联动梦幻西游","第四期：幻年降临~2020","第十二期：十二生肖"],"a":1,"d":"m1-020","an":"e43","k":"src","x":"原文：《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「10.水瓶座」出自哪一篇？","o":["第二十六期：隐曜洞徽","第十一期：雾山五行","第十三期：十二星座","第二十二期：星海探梦"],"a":2,"d":"m1-012","an":"e10","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"「异次元空间∽神技」的效果是？","o":["本场无视所有级别攻击。","战斗中可派出所有同系精灵进行依次叠加，该效果无视神威，弱抗。若胜则均返还，返还精灵均只剩一次使用机会。若败，则助战精灵丢入弃牌区，并获得对应张数n张牌。","本场先行，掷骰子决定从神兽区召唤数量，令召唤神兽助战，有血值和攻击，有阶级(仅生肖最高阶级)，该召唤神兽在战斗结束后均返还。","可开启极巨化空间，其余玩家均拥有一次极具巨化效果。我方掷骰子决定，我方至少获得三次该效果。"],"a":2,"d":"m3-001","an":"e99","k":"body","x":"出自《精灵阶级第一章》"},{"q":"效果：「第一牌区末：手牌上限20张。 第二牌区末：手牌上限20张。」\n这是哪一张？","o":["第二组：隐曜逆元+隐曜洞徽+幻世阅书","10.最终决战模式","28.闪现活复甲：活动级","9.该模式共2个牌区"],"a":3,"d":"m2-003","an":"e3","k":"name","x":"出自《第四模式：混沌之战》"},{"q":"「14.王权卡」的效果是？","o":["免疫对方技能卡一次。","①增加技能卡使用数量 ②无视所有技能卡本回合","捕捉神兽及以下，三次。","捕捉神及以下，三次。"],"a":1,"d":"m1-002","an":"e16","k":"body","x":"出自《第一期：除魔卫道》"},{"q":"「7.幸运卡」出自哪一篇？","o":["第二十八期：隐曜逆元","第九期：九妖王归位","关于26年专属年卡和限定年卡的额外说明","第一期：除魔卫道"],"a":3,"d":"m1-002","an":"e9","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"效果：「出场的一回合免疫伤害、阶级、负面效果 并持续免疫弱抗，但我方血值与光之巨人血值没有关联，只计总伤害。 ③能量石专门抽神兽，光之石专门抽奥特曼，奥特曼位于英雄」\n这是哪一张？","o":["⑤版本介绍","天启系列","光之巨人特性","太初无极"],"a":2,"d":"core-003","an":"e101","k":"name","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"「2.辰龙」出自哪一篇？","o":["第三十九期：诸神愚戏","第十期：新世纪~未来纪元","第二十二期：星海探梦","第十二期：十二生肖"],"a":3,"d":"m1-011","an":"e5","k":"src","x":"原文：《第十二期：十二生肖》"},{"q":"「8.保护卡」出自哪一篇？","o":["技能卡阶级第一章","第三十四期：终战之巅","第二十一期：征天揽星","第一期：除魔卫道"],"a":3,"d":"m1-002","an":"e10","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"「3.时空迁跃」出自哪一篇？","o":["第十期：新世纪~未来纪元","第二十七期：天启降临~神界宙轨","第二期：庆牛年~喜气冲天","第三十六期：守望新星~新生气象"],"a":0,"d":"m1-009","an":"e3","k":"src","x":"原文：《第十期：新世纪~未来纪元》"},{"q":"效果：「无视神级，圣兽效果与阶级行动拥有一次一战之力。」\n这是哪一张？","o":["异次元空间∽神技","五，极巨化之神：无极汰那","③三圣护体∽神技","①圣火领域∽神技"],"a":3,"d":"m3-001","an":"e113","k":"name","x":"出自《精灵阶级第一章》"},{"q":"「机制五十七：机制限定-------神威」的效果是？","o":["当上场战斗结束，下场战斗已经开始时，上场所出现的一切错误均有效，无法补救，无法倒退！！！","作为全局胜者（在最终决战中获胜）会获得终局王者印记一枚，该印记任何时候，任何模式，永久标记，永久生效！！！","由机制统领六大模块，分别是：技能卡阶级，模式玩法，精灵阶级，更新，优调，玩法规则。","令普通精灵和三级神直接臣服！！！"],"a":3,"d":"core-001","an":"e51","k":"body","x":"出自《机制介绍》"},{"q":"效果：「①敌方本回合不可行动 ②敌方下回合不可行动 ③敌方本场不可使用技能卡 三选一。」\n这是哪一张？","o":["2.失魂符/定身符","9.横扫千军","10.翻江倒海","6.判官令/阎罗令"],"a":0,"d":"m1-020","an":"e20","k":"name","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「8.酉鸡」出自哪一篇？","o":["第二十二期：星海探梦","第二十六期：隐曜洞徽","第十二期：十二生肖","第二十九期：幻世阅书~终末"],"a":2,"d":"m1-011","an":"e11","k":"src","x":"原文：《第十二期：十二生肖》"},{"q":"「11.白羊座」的效果是？","o":["当我方血值高于对方时，可一击必杀","存活时，所有人2vs2","抵挡一次伤害并增加一个护盾","收取对方精灵，仅1次使用机会"],"a":3,"d":"m1-012","an":"e11","k":"body","x":"出自《第十三期：十二星座》"},{"q":"「第五级：常规级」的效果是？","o":["定义：作为技能卡第二级别的存在，当妖神出世，其余玩家拥有妖王便可与之拥有一战之力，因此该级别是可称霸一方的存在，可以快速发展，强大获取大量增益，拥有强大的技","-恐惧：令一名玩家停止行动，不可行动，不可用技能卡一次。 -专属年卡特权：蛇年可额外获得一次抽神兽。","定义：随活动而来但常驻的套系技能卡，提供较为基础的技能与强度。","定义：作为技能卡巅峰的存在，拥有最高权限一一机制权限，能引导全局发展走向，拥有强大技能，是可扭转全局的存在，换言之，拥有妖神级，便能称霸天下，不仅技能异常强"],"a":2,"d":"m1-001","an":"e15","k":"body","x":"出自《技能卡阶级第一章》"},{"q":"「第一级：妖神级」的效果是？","o":["定义：作为技能卡巅峰的存在，拥有最高权限一一机制权限，能引导全局发展走向，拥有强大技能，是可扭转全局的存在，换言之，拥有妖神级，便能称霸天下，不仅技能异常强","前程似锦，福运亨通。 新春多喜乐，岁岁年年无忧虑！！！ 新春大吉，万事如意！","定义：随活动而来但常驻的套系技能卡，提供较为基础的技能与强度。","在触发完本技能卡后，获一次抽神兽。"],"a":0,"d":"m1-001","an":"e3","k":"body","x":"出自《技能卡阶级第一章》"},{"q":"「超限修复∽神技」的效果是？","o":["本场每献祭一只精灵，便可直接成功一万。","本场无视所有级别攻击。","获得一次重生满战，满增益效果，可刷新一次阶级，可刷新我方战败前所有技能卡效果。","战斗中可派出所有同系精灵进行依次叠加，该效果无视神威，弱抗。若胜则均返还，返还精灵均只剩一次使用机会。若败，则助战精灵丢入弃牌区，并获得对应张数n张牌。"],"a":3,"d":"m3-001","an":"e107","k":"body","x":"出自《精灵阶级第一章》"},{"q":"「5.囚牛」的效果是？","o":["满血时用获得2个护盾，残血时用获得1个护盾和一次行动。","对同系一击必杀，对异系伤害x2","每次伤害无视护盾，本场伤害X2。","本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。"],"a":1,"d":"m1-021","an":"e23","k":"body","x":"出自《第三十一期：龙生九子联动》"},{"q":"「26.天秤座」出自哪一篇？","o":["第一模式：联动玩法","第十二模式：铠甲勇士~铠传","第八模式：创世纪~神器之战","模式总介绍"],"a":2,"d":"m2-004","an":"e73","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「12.戌狗」的效果是？","o":["先起三张，看后放回，若败则起另外三张","可收取局内已阵亡精灵，获一次使用机会","满血时，血值×2，残血或阵亡时仅增1倍血","增加1万血值或者增加1万攻击。 备案：该版本为第六版，为最新版本。始创于21年年末，和12星座一样为庆祝22年做准备。"],"a":3,"d":"m1-011","an":"e15","k":"body","x":"出自《第十二期：十二生肖》"},{"q":"「①圣火领域∽神技」的效果是？","o":["本场先行，掷骰子决定从神兽区召唤数量，令召唤神兽助战，有血值和攻击，有阶级(仅生肖最高阶级)，该召唤神兽在战斗结束后均返还。","无视神级，圣兽效果与阶级行动拥有一次一战之力。","令每之极巨化精灵(Vmax)的攻击和血值额外加4万;每只极巨化精灵之间无弱抗影响，且不受非极巨化精灵弱抗影响，极巨化效果同样对迦勒尔精灵生效。","本场每献祭一只精灵，便可复活我方一只精灵恢复满血满战该献祭还可抵挡一次死亡效果（即可以抵挡神威，弱抗，攻击），不限次数。"],"a":1,"d":"m3-001","an":"e113","k":"body","x":"出自《精灵阶级第一章》"},{"q":"「7.每牌区玩家精灵手牌上限」出自哪一篇？","o":["模式总介绍","第九模式：觉醒之战","第一模式：联动玩法","第十一模式：诸神愚戏"],"a":1,"d":"m2-005","an":"e5","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"效果：「1.青龙之力：妖王（东方青龙木）」\n这是哪一张？","o":["52.申猴","第一组：灵兽宫·六妖王","53.子鼠","58.戌狗"],"a":1,"d":"m2-005","an":"e15","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"效果：「佩戴给龙属性精灵时，将加持免疫弱抗， 阶级伤害无效、一击必杀无效， 同时血攻防×2」\n这是哪一张？","o":["指导","6.判官令/阎罗令","免疫","5.龙腾"],"a":3,"d":"m1-020","an":"e26","k":"name","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"效果：「玩家撤退成功，将丢入弃牌区，且视为直接战死！！！」\n这是哪一张？","o":["机制五十九：机制限定一一一一终局王者印记","机制八：关于游戏框架","机制五十五：机制限定----战至终章","机制五十六：机制限定----一裁终局"],"a":2,"d":"core-001","an":"e49","k":"name","x":"出自《机制介绍》"},{"q":"效果：「（这里说一下禁物，神物，神技，超高危，神墟等同于活动级，部分神墟有特殊说明除外，王墟一般是妖王级）」\n这是哪一张？","o":["30.巨蟹座","37.星系","27.金牛座","第一组：斩神联动"],"a":3,"d":"m2-004","an":"e17","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「掷骰子决定所有玩家要丢弃的精灵」的效果是？","o":["①当前攻击高于我方 ②当前血值高于我方 ③当前阶级高于我方 每场只能选一或二，该判定结果为必杀。","①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级","一点普通X3， 二点3级神×2， 三点神兽X2， 四点二级神， 五点普通X3， 六点普通X3。","①当前血值低于我方 ②当前攻击低于我方 ③当前阶级低于我方"],"a":2,"d":"m1-026","an":"e18","k":"body","x":"出自《第三十八期：完美世界~帝关之战》"},{"q":"效果：「第一区：40张；第二区：30张；第三区：20张」\n这是哪一张？","o":["54.酉鸡","52.申猴","11.该模式配置","7.每牌区玩家精灵手牌上限"],"a":3,"d":"m2-005","an":"e5","k":"name","x":"出自《第九模式：觉醒之战》"},{"q":"「机制五十六：机制限定----一裁终局」的效果是？","o":["令普通精灵和三级神直接臣服！！！","当上场战斗结束，下场战斗已经开始时，上场所出现的一切错误均有效，无法补救，无法倒退！！！","玩家撤退成功，将丢入弃牌区，且视为直接战死！！！","作为全局胜者（在最终决战中获胜）会获得终局王者印记一枚，该印记任何时候，任何模式，永久标记，永久生效！！！"],"a":1,"d":"core-001","an":"e50","k":"body","x":"出自《机制介绍》"},{"q":"效果：「本场先行，掷骰子决定从神兽区召唤数量，令召唤神兽助战，有血值和攻击，有阶级(仅生肖最高阶级)，该召唤神兽在战斗结束后均返还。」\n这是哪一张？","o":["异次元空间∽神技","五，极巨化之神：无极汰那","①圣火领域∽神技","①创生本源∽神技"],"a":0,"d":"m3-001","an":"e99","k":"name","x":"出自《精灵阶级第一章》"},{"q":"效果：「5.全场嘲讽之力：活动级 本场所有伤害，每次最多仅造成我方血值的33%。」\n这是哪一张？","o":["第二组：隐曜逆元+隐曜洞徽+幻世阅书","9.该模式共2个牌区","10.最终决战模式","28.闪现活复甲：活动级"],"a":0,"d":"m2-003","an":"e28","k":"name","x":"出自《第四模式：混沌之战》"},{"q":"「37.星系」出自哪一篇？","o":["关于26年专属年卡和限定年卡的额外说明","第九模式：觉醒之战","第八模式：创世纪~神器之战","第十一模式：诸神愚戏"],"a":2,"d":"m2-004","an":"e86","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「10.水瓶座」的效果是？","o":["反伤1次，我方受伤为0，以自身血值反伤","收取对方精灵，仅1次使用机会","抽神兽×2，1次或者起二张牌/或者获1技能卡","抵挡一次伤害并增加一个护盾"],"a":2,"d":"m1-012","an":"e10","k":"body","x":"出自《第十三期：十二星座》"},{"q":"「14.王权卡」出自哪一篇？","o":["第二十二期：星海探梦","第十期：新世纪~未来纪元","第一期：除魔卫道","第二十九期：幻世阅书~终末"],"a":2,"d":"m1-002","an":"e16","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"效果：「①抽神兽时三选一 ②起牌时九选三 二选一」\n这是哪一张？","o":["10.翻江倒海","11.冰川怒","9.横扫千军","5.龙腾"],"a":0,"d":"m1-020","an":"e34","k":"name","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「第一组：完美世界联动」的效果是？","o":["①当前攻击高于我方 ②当前血值高于我方 ③当前阶级高于我方 每场只能选一或二，该判定结果为必杀。","①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级","普通：+3000 阶级：+6000","本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。"],"a":1,"d":"m2-006","an":"e38","k":"body","x":"出自《第十模式：帝关之战》"},{"q":"效果：「拥有三次各属性征调机会，本场可征调一次水系火系电系，为我方出战精灵助战，战斗结束后征调精灵均丢入弃牌区，征调精灵从我方手牌中打出。」\n这是哪一张？","o":["异次元空间∽神技","①圣火领域∽神技","②神罚效果∽神技","③三圣护体∽神技"],"a":3,"d":"m3-001","an":"e115","k":"name","x":"出自《精灵阶级第一章》"},{"q":"「5.囚牛」出自哪一篇？","o":["第十期：新世纪~未来纪元","第二十二期：星海探梦","第三十一期：龙生九子联动","第三十八期：完美世界~帝关之战"],"a":2,"d":"m1-021","an":"e23","k":"src","x":"原文：《第三十一期：龙生九子联动》"},{"q":"「4.巳蛇」的效果是？","o":["先起三张，看后放回，若败则起另外三张","恐惧：令任意玩家停止行动、不可行动、不可用技能一次。","满血时，血值×2，残血或阵亡时仅增1倍血","可收取局内已阵亡精灵，获一次使用机会"],"a":1,"d":"m1-011","an":"e7","k":"body","x":"出自《第十二期：十二生肖》"},{"q":"「50.巳蛇」出自哪一篇？","o":["关于26年专属年卡和限定年卡的额外说明","第九模式：觉醒之战","第一模式：联动玩法","第八模式：创世纪~神器之战"],"a":1,"d":"m2-005","an":"e160","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"「18.猎铠鹰帅」的效果是？","o":["1.封印技：象帅爆啸轰 三倍血值","1.必杀技：漩啸裂怪刺 自曝5000血，可直接群攻一万，无须行动，血值<5000时，不生效。 2.封印技：涡轮旋魈煞 每次受伤为50%，并将原攻击的30%返","1.必杀技：焰炬熔麟煞 100%格挡+反伤一次。 2.封印技：熔焰分魔劈 我方获得一个护盾，并拥有一次反伤1万。二选一。","1.封印技：凤翎杀破狼 夺取本场一只死亡精灵，补偿击杀者2只起牌区精灵。"],"a":3,"d":"m2-008","an":"e88","k":"body","x":"出自《第十二模式：铠甲勇士~铠传》"},{"q":"效果：「该技能，可以焚灭与夺取本场此前出现的所有精灵与特权之下的技能卡。 包括死亡精灵与已经使用的技能卡。我方出战的精灵需要丢入弃牌区。」\n这是哪一张？","o":["第一，二，三层","（2）阳之极","（1）灭妖神火","（一），诛仙"],"a":2,"d":"m1-008","an":"e7","k":"name","x":"出自《第九期：九妖王归位》"},{"q":"「2.失魂符/定身符」的效果是？","o":["标记其余人，通过掷骰子决定其 本场共可行动次数，次数达到后 将视为不可生还，同时无法行动","每次攻击附带全场每人的50%","①敌方本回合不可行动 ②敌方下回合不可行动 ③敌方本场不可使用技能卡 三选一。","①死亡后满血并刷新阶级 ②如贼卡、神威、弱抗等无效 ③免疫80%技能卡 ④本回合存在直接结束时、撤退时 计为我方获胜"],"a":2,"d":"m1-020","an":"e20","k":"body","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「（二），逆袭封神榜」出自哪一篇？","o":["第七期：轮回转世~再续前缘","第三十九期：诸神愚戏","第九期：九妖王归位","第十三期：十二星座"],"a":2,"d":"m1-008","an":"e36","k":"src","x":"原文：《第九期：九妖王归位》"},{"q":"效果：「当上场战斗结束，下场战斗已经开始时，上场所出现的一切错误均有效，无法补救，无法倒退！！！」\n这是哪一张？","o":["机制五十六：机制限定----一裁终局","机制五十七：机制限定-------神威","机制五十五：机制限定----战至终章","机制五十一：机制限定-----技能毕用"],"a":0,"d":"core-001","an":"e50","k":"name","x":"出自《机制介绍》"},{"q":"「光之巨人特性」的效果是？","o":["出场的一回合免疫伤害、阶级、负面效果 并持续免疫弱抗，但我方血值与光之巨人血值没有关联，只计总伤害。 ③能量石专门抽神兽，光之石专门抽奥特曼，奥特曼位于英雄","掷骰子后自行扩大倍数，抽取神兽区对应位置精灵(扩大倍数在神兽区可数范围内)","天启降临·神界宙轨2023年4月28日 下午3点","处理一直以来未解决的神兽机制，开创新模式以适配完善“终决”弊端，创造新型强度技能卡。 完善三大机制：模式决战、技能威望、神兽威望"],"a":0,"d":"core-003","an":"e101","k":"body","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"「第一组：灵兽宫·六妖王」的效果是？","o":["1.青龙之力：妖王（东方青龙木）","恐惧：令任意玩家停止行动、不可行动、不可用技能一次。","除青龙之力、麒麟瑞兽两妖王之外，在其它妖王领域之内（四妖王）若存在逃跑玩家，则该妖王次数重置。","恢复一半血，并获一个护盾"],"a":0,"d":"m2-005","an":"e15","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"「帝关之战技能卡」出自哪一篇？","o":["第二十六期：隐曜洞徽","第三十七期：斩神联动","第九期：九妖王归位","第三十八期：完美世界~帝关之战"],"a":3,"d":"m1-026","an":"e1","k":"src","x":"原文：《第三十八期：完美世界~帝关之战》"},{"q":"效果：「①死亡后用：增1万血+1万攻 ②死亡前用：免疫本次行动，直接撤退并重置为1次使用机会。」\n这是哪一张？","o":["第二组：隐曜逆元+隐曜洞徽+幻世阅书","28.闪现活复甲：活动级","9.该模式共2个牌区","10.最终决战模式"],"a":1,"d":"m2-003","an":"e89","k":"name","x":"出自《第四模式：混沌之战》"},{"q":"「第二组：隐曜逆元+隐曜洞徽+幻世阅书」出自哪一篇？","o":["第四模式：混沌之战","第九模式：觉醒之战","模式总介绍","第十二模式：铠甲勇士~铠传"],"a":0,"d":"m2-003","an":"e28","k":"src","x":"原文：《第四模式：混沌之战》"},{"q":"「2.幻影卡」出自哪一篇？","o":["第二十五期：祈愿护梦~庆兔年","第一期：除魔卫道","第二十六期：隐曜洞徽","第二十七期：天启降临~神界宙轨"],"a":1,"d":"m1-002","an":"e4","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"效果：「①死亡 ②控制、强制施实 ③技能卡 ④结束事件」\n这是哪一张？","o":["5.龙腾","9.横扫千军","11.冰川怒","免疫"],"a":3,"d":"m1-020","an":"e42","k":"name","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「27.金牛座」的效果是？","o":["所有玩家均只有1万血","反伤1次，我方受伤为0，以自身血值反伤","具有可抢夺性质，可以击已死亡精灵。 当我方攻击值总和≥死亡精灵血值，则可获得。","所有人额外获一张技能卡"],"a":1,"d":"m2-004","an":"e74","k":"body","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「③三圣护体∽神技」的效果是？","o":["本场无视所有级别攻击。","获得一次重生满战，满增益效果，可刷新一次阶级，可刷新我方战败前所有技能卡效果。","本场每献祭一只精灵，便可复活我方一只精灵恢复满血满战该献祭还可抵挡一次死亡效果（即可以抵挡神威，弱抗，攻击），不限次数。","拥有三次各属性征调机会，本场可征调一次水系火系电系，为我方出战精灵助战，战斗结束后征调精灵均丢入弃牌区，征调精灵从我方手牌中打出。"],"a":3,"d":"m3-001","an":"e115","k":"body","x":"出自《精灵阶级第一章》"},{"q":"效果：「可重抽神兽或重获技能卡或重置精灵1次使用机会，视情况而定。」\n这是哪一张？","o":["37.星系","26.天秤座","35.斗系","24.天蝎座"],"a":3,"d":"m2-004","an":"e71","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"效果：「可收取局内已阵亡精灵，获一次使用机会」\n这是哪一张？","o":["5.亥猪","6.申猴","8.酉鸡","7.子鼠"],"a":0,"d":"m1-011","an":"e8","k":"name","x":"出自《第十二期：十二生肖》"},{"q":"「54.酉鸡」出自哪一篇？","o":["关于26年专属年卡和限定年卡的额外说明","第十模式：帝关之战","第八模式：创世纪~神器之战","第九模式：觉醒之战"],"a":3,"d":"m2-005","an":"e164","k":"src","x":"原文：《第九模式：觉醒之战》"},{"q":"「28.水瓶座」出自哪一篇？","o":["第十模式：帝关之战","第十一模式：诸神愚戏","第八模式：创世纪~神器之战","第九模式：觉醒之战"],"a":2,"d":"m2-004","an":"e75","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「3.每牌区末开启两场晋神之路」的效果是？","o":["首位特权妖神级 提示：该技能所有解释权归系统所有。","本场我方可分配自身血值和攻击5000点给别人，当分配选择清零后，即完成任务。我方死因，分配清零而亡。","灵魂安眠，生命终焉。 ①见证一次全灭，额外获得三张牌。 ②累计击杀5只同系精灵，便可以从弃牌区获得任意两只精灵。额外获得1张牌。 ③见证一次全场阶级，额外获","每位玩家随机获得3~4张晋见神明卡，选择一张在本场完成即可获得对应奖励。"],"a":3,"d":"m2-007","an":"e3","k":"body","x":"出自《第十一模式：诸神愚戏》"},{"q":"效果：「①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级」\n这是哪一张？","o":["第一组：完美世界联动","㉚囚牛","20.神级精灵被限制情况","㉛狻猊"],"a":0,"d":"m2-006","an":"e38","k":"name","x":"出自《第十模式：帝关之战》"},{"q":"「1.摩羯座」出自哪一篇？","o":["第三十二期：灵兽宫~珍宝秘笈","第三十七期：斩神联动","第二十一期：征天揽星","第十三期：十二星座"],"a":3,"d":"m1-012","an":"e1","k":"src","x":"原文：《第十三期：十二星座》"},{"q":"「5.亥猪」的效果是？","o":["可收取局内已阵亡精灵，获一次使用机会","复活，并持续2万暴击","增加1万血值或者增加1万攻击。 备案：该版本为第六版，为最新版本。始创于21年年末，和12星座一样为庆祝22年做准备。","恐惧：令任意玩家停止行动、不可行动、不可用技能一次。"],"a":0,"d":"m1-011","an":"e8","k":"body","x":"出自《第十二期：十二生肖》"},{"q":"「（1）灭妖神火」出自哪一篇？","o":["第三十四期：终战之巅","第二十五期：祈愿护梦~庆兔年","第一期：除魔卫道","第九期：九妖王归位"],"a":3,"d":"m1-008","an":"e7","k":"src","x":"原文：《第九期：九妖王归位》"},{"q":"「帝关之战技能卡」的效果是？","o":["一点普通X3， 二点3级神×2， 三点神兽X2， 四点二级神， 五点普通X3， 六点普通X3。","①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级","①当前攻击高于我方 ②当前血值高于我方 ③当前阶级高于我方 每场只能选一或二，该判定结果为必杀。","①当前血值低于我方 ②当前攻击低于我方 ③当前阶级低于我方"],"a":1,"d":"m1-026","an":"e1","k":"body","x":"出自《第三十八期：完美世界~帝关之战》"},{"q":"「9.横扫千军」出自哪一篇？","o":["第三十期：幻梦游园：联动梦幻西游","第三十一期：龙生九子联动","第三十八期：完美世界~帝关之战","第三十七期：斩神联动"],"a":0,"d":"m1-020","an":"e33","k":"src","x":"原文：《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「5.决战阶段」的效果是？","o":["八只精灵单体对决，累计获胜4~5场即可获得终局王者印记。该阶段无技能卡可用。","每位玩家随机获得3~4张晋见神明卡，选择一张在本场完成即可获得对应奖励。","该技能仅在第一次必中。此后每场有50%的概率现世。现世后仅有1%的概率触发技能。","本场n人则在n回合内结束战斗。"],"a":0,"d":"m2-007","an":"e5","k":"body","x":"出自《第十一模式：诸神愚戏》"},{"q":"「10.最终决战模式」出自哪一篇？","o":["第十模式：帝关之战","第十二模式：铠甲勇士~铠传","第四模式：混沌之战","第九模式：觉醒之战"],"a":2,"d":"m2-003","an":"e4","k":"src","x":"原文：《第四模式：混沌之战》"},{"q":"效果：「太初之时，混沌黑暗，以光明显现， 大道初立，是为正道。」\n这是哪一张？","o":["太初无极","①抽神兽机制调改","⑤版本介绍","不断跨越再超越"],"a":0,"d":"core-003","an":"e143","k":"name","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"「立意，正式确定常规阶级」出自哪一篇？","o":["第二十六期：隐曜洞徽","第三十七期：斩神联动","第二期：庆牛年~喜气冲天","第二十八期：隐曜逆元"],"a":2,"d":"m1-003","an":"e18","k":"src","x":"原文：《第二期：庆牛年~喜气冲天》"},{"q":"「6.申猴」出自哪一篇？","o":["第二十六期：隐曜洞徽","第二十九期：幻世阅书~终末","第十二期：十二生肖","第三十一期：龙生九子联动"],"a":2,"d":"m1-011","an":"e9","k":"src","x":"原文：《第十二期：十二生肖》"},{"q":"「8.酉鸡」的效果是？","o":["复活，并持续2万暴击","恐惧：令任意玩家停止行动、不可行动、不可用技能一次。","可收取局内已阵亡精灵，获一次使用机会","先起三张，看后放回，若败则起另外三张"],"a":3,"d":"m1-011","an":"e11","k":"body","x":"出自《第十二期：十二生肖》"},{"q":"效果：「当我方血值高于对方时，可一击必杀」\n这是哪一张？","o":["37.星系","28.水瓶座","35.斗系","26.天秤座"],"a":3,"d":"m2-004","an":"e73","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「5.龙腾」出自哪一篇？","o":["第十期：新世纪~未来纪元","第三十期：幻梦游园：联动梦幻西游","第二十五期：祈愿护梦~庆兔年","第二期：庆牛年~喜气冲天"],"a":1,"d":"m1-020","an":"e26","k":"src","x":"原文：《第三十期：幻梦游园：联动梦幻西游》"},{"q":"效果：「可开启极巨化空间，其余玩家均拥有一次极具巨化效果。我方掷骰子决定，我方至少获得三次该效果。」\n这是哪一张？","o":["③全知神域∽神技","③三圣护体∽神技","②圣洁领域∽神技","五，极巨化之神：无极汰那"],"a":3,"d":"m3-001","an":"e108","k":"name","x":"出自《精灵阶级第一章》"},{"q":"「11.冰川怒」的效果是？","o":["①死亡 ②控制、强制施实 ③技能卡 ④结束事件","濒危时，增加一个护盾，并令与对方 同级别的精灵除自己外都下场","标记其余人，通过掷骰子决定其 本场共可行动次数，次数达到后 将视为不可生还，同时无法行动","每次攻击附带全场每人的50%"],"a":1,"d":"m1-020","an":"e35","k":"body","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「②神罚效果∽神技」的效果是？","o":["本场先行，掷骰子决定从神兽区召唤数量，令召唤神兽助战，有血值和攻击，有阶级(仅生肖最高阶级)，该召唤神兽在战斗结束后均返还。","本场无视所有级别攻击。","拥有三次各属性征调机会，本场可征调一次水系火系电系，为我方出战精灵助战，战斗结束后征调精灵均丢入弃牌区，征调精灵从我方手牌中打出。","本场每献祭一只精灵，便可直接成功一万。"],"a":3,"d":"m3-001","an":"e102","k":"body","x":"出自《精灵阶级第一章》"},{"q":"效果：「当有人使用技能卡后，该玩家需要献祭1只精灵。」\n这是哪一张？","o":["（一），诛仙","第六，七层","第一，二，三层","（1）灭妖神火"],"a":2,"d":"m1-008","an":"e33","k":"name","x":"出自《第九期：九妖王归位》"},{"q":"「54.酉鸡」的效果是？","o":["恢复一半血，并获一个护盾","满血时，血值×2，残血或阵亡时仅增1倍血","先起三张，看后放回，若败则起另外三张","可收取局内已阵亡精灵，获一次使用机会"],"a":2,"d":"m2-005","an":"e164","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"「20.神级精灵被限制情况」出自哪一篇？","o":["第一模式：联动玩法","第十二模式：铠甲勇士~铠传","第十模式：帝关之战","第八模式：创世纪~神器之战"],"a":2,"d":"m2-006","an":"e35","k":"src","x":"原文：《第十模式：帝关之战》"},{"q":"「10.最终决战模式」的效果是？","o":["无神威，无弱抗，所有精灵无限叠加，所有阶级均生效，大部分技能卡均有效。 无手牌者战死，最后在场者为终局胜者，获终局王者印记。","第一牌区末：手牌上限20张。 第二牌区末：手牌上限20张。","①死亡后用：增1万血+1万攻 ②死亡前用：免疫本次行动，直接撤退并重置为1次使用机会。","5.全场嘲讽之力：活动级 本场所有伤害，每次最多仅造成我方血值的33%。"],"a":0,"d":"m2-003","an":"e4","k":"body","x":"出自《第四模式：混沌之战》"},{"q":"「24.天蝎座」出自哪一篇？","o":["第八模式：创世纪~神器之战","第九模式：觉醒之战","关于26年专属年卡和限定年卡的额外说明","第十一模式：诸神愚戏"],"a":0,"d":"m2-004","an":"e71","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"「9.横扫千军」的效果是？","o":["①敌方本回合不可行动 ②敌方下回合不可行动 ③敌方本场不可使用技能卡 三选一。","每次攻击附带全场每人的50%","濒危时，增加一个护盾，并令与对方 同级别的精灵除自己外都下场","①死亡后满血并刷新阶级 ②如贼卡、神威、弱抗等无效 ③免疫80%技能卡 ④本回合存在直接结束时、撤退时 计为我方获胜"],"a":1,"d":"m1-020","an":"e33","k":"body","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「9.该模式共2个牌区」的效果是？","o":["第一牌区末：手牌上限20张。 第二牌区末：手牌上限20张。","①死亡后用：增1万血+1万攻 ②死亡前用：免疫本次行动，直接撤退并重置为1次使用机会。","无神威，无弱抗，所有精灵无限叠加，所有阶级均生效，大部分技能卡均有效。 无手牌者战死，最后在场者为终局胜者，获终局王者印记。","5.全场嘲讽之力：活动级 本场所有伤害，每次最多仅造成我方血值的33%。"],"a":0,"d":"m2-003","an":"e3","k":"body","x":"出自《第四模式：混沌之战》"},{"q":"「4.睚眦」的效果是？","o":["对同系一击必杀，对异系伤害x2","本场如果A玩家攻击了B玩家，那么我方帮助A玩家击杀B玩家并将其交予A玩家，则可获得3张牌。即本场帮助别人击杀则可获得3张牌。","每次伤害无视护盾，本场伤害X2。","满血时用获得2个护盾，残血时用获得1个护盾和一次行动。"],"a":2,"d":"m1-021","an":"e22","k":"body","x":"出自《第三十一期：龙生九子联动》"},{"q":"效果：「掷骰子后自行扩大倍数，抽取神兽区对应位置精灵(扩大倍数在神兽区可数范围内)」\n这是哪一张？","o":["不断跨越再超越","太初无极","光之巨人特性","①抽神兽机制调改"],"a":3,"d":"core-003","an":"e98","k":"name","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"「30.巨蟹座」出自哪一篇？","o":["第八模式：创世纪~神器之战","关于26年专属年卡和限定年卡的额外说明","第十一模式：诸神愚戏","第十模式：帝关之战"],"a":0,"d":"m2-004","an":"e77","k":"src","x":"原文：《第八模式：创世纪~神器之战》"},{"q":"效果：「本回合无视对方攻击一次，从神兽区召唤助阵（有阶级）。」\n这是哪一张？","o":["3.抗疫情卡","7.幸运卡","14.王权卡","10.隐身卡"],"a":0,"d":"m1-002","an":"e5","k":"name","x":"出自《第一期：除魔卫道》"},{"q":"「指导」的效果是？","o":["每次攻击附带全场每人的50%","①死亡后满血并刷新阶级 ②如贼卡、神威、弱抗等无效 ③免疫80%技能卡 ④本回合存在直接结束时、撤退时 计为我方获胜","①死亡 ②控制、强制施实 ③技能卡 ④结束事件","佩戴给龙属性精灵时，将加持免疫弱抗， 阶级伤害无效、一击必杀无效， 同时血攻防×2"],"a":1,"d":"m1-020","an":"e43","k":"body","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「10.翻江倒海」出自哪一篇？","o":["第三十期：幻梦游园：联动梦幻西游","第二十一期：征天揽星","第三十八期：完美世界~帝关之战","第一期：除魔卫道"],"a":0,"d":"m1-020","an":"e34","k":"src","x":"原文：《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「第二级：妖王级」的效果是？","o":["前程似锦，福运亨通。 新春多喜乐，岁岁年年无忧虑！！！ 新春大吉，万事如意！","-恐惧：令一名玩家停止行动，不可行动，不可用技能卡一次。 -专属年卡特权：蛇年可额外获得一次抽神兽。","定义：作为技能卡第二级别的存在，当妖神出世，其余玩家拥有妖王便可与之拥有一战之力，因此该级别是可称霸一方的存在，可以快速发展，强大获取大量增益，拥有强大的技","在触发完本技能卡后，获一次抽神兽。"],"a":2,"d":"m1-001","an":"e6","k":"body","x":"出自《技能卡阶级第一章》"},{"q":"效果：「抽神兽×2，1次或者起二张牌/或者获1技能卡」\n这是哪一张？","o":["10.水瓶座","8.天秤座","6.天蝎座","1.摩羯座"],"a":0,"d":"m1-012","an":"e10","k":"name","x":"出自《第十三期：十二星座》"},{"q":"「真伤，对精灵进行伤害加成」出自哪一篇？","o":["第四模式：混沌之战","模式总介绍","第十模式：帝关之战","第十一模式：诸神愚戏"],"a":2,"d":"m2-006","an":"e88","k":"src","x":"原文：《第十模式：帝关之战》"},{"q":"「（1）灭妖神火」的效果是？","o":["共七层印记，每叠加一层需要完成对应需求。 第每层印记对应第每张技能卡，从获得该妖神时诛仙自动触发。 全场参与。","该技能，可以焚灭与夺取本场此前出现的所有精灵与特权之下的技能卡。 包括死亡精灵与已经使用的技能卡。我方出战的精灵需要丢入弃牌区。","选定任意一只普通精灵，封为一级神，有阶级与神威，血值增加4万，攻击增加3万。 该精灵有3次使用机会。该封神为机制认可，无法被抵消。","每有人使用技能卡时，我方需要献祭3只精灵。 当七层印记叠满，获得奖励：2只神兽+5张牌。"],"a":1,"d":"m1-008","an":"e7","k":"body","x":"出自《第九期：九妖王归位》"},{"q":"「28.闪现活复甲：活动级」出自哪一篇？","o":["第四模式：混沌之战","第八模式：创世纪~神器之战","关于26年专属年卡和限定年卡的额外说明","模式总介绍"],"a":0,"d":"m2-003","an":"e89","k":"src","x":"原文：《第四模式：混沌之战》"},{"q":"「8.天秤座」的效果是？","o":["反伤1次，我方受伤为0，以自身血值反伤","收取对方精灵，仅1次使用机会","当我方血值高于对方时，可一击必杀","所有玩家均只有1万血"],"a":2,"d":"m1-012","an":"e8","k":"body","x":"出自《第十三期：十二星座》"},{"q":"「6.判官令/阎罗令」出自哪一篇？","o":["第三十期：幻梦游园：联动梦幻西游","第七期：轮回转世~再续前缘","第三十八期：完美世界~帝关之战","关于26年专属年卡和限定年卡的额外说明"],"a":0,"d":"m1-020","an":"e27","k":"src","x":"原文：《第三十期：幻梦游园：联动梦幻西游》"},{"q":"效果：「①死亡后满血并刷新阶级 ②如贼卡、神威、弱抗等无效 ③免疫80%技能卡 ④本回合存在直接结束时、撤退时 计为我方获胜」\n这是哪一张？","o":["10.翻江倒海","9.横扫千军","2.失魂符/定身符","指导"],"a":3,"d":"m1-020","an":"e43","k":"name","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「（二），逆袭封神榜」的效果是？","o":["当有人使用技能卡时，该玩家需要献祭2只精灵。","选定任意一只普通精灵，封为一级神，有阶级与神威，血值增加4万，攻击增加3万。 该精灵有3次使用机会。该封神为机制认可，无法被抵消。","共七层印记，每叠加一层需要完成对应需求。 第每层印记对应第每张技能卡，从获得该妖神时诛仙自动触发。 全场参与。","当集齐15张神兽级别及以上的精灵+一位一级神+一位圣兽时，可进行如下2选1： ①焚灭所有玩家手牌，本局直接获胜。 ②焚灭起牌区与神兽区，直接开启决战。"],"a":1,"d":"m1-008","an":"e36","k":"body","x":"出自《第九期：九妖王归位》"},{"q":"效果：「战斗中可派出所有同系精灵进行依次叠加，该效果无视神威，弱抗。若胜则均返还，返还精灵均只剩一次使用机会。若败，则助战精灵丢入弃牌区，并获得对应张数n张牌。」\n这是哪一张？","o":["③三圣护体∽神技","极巨化效果","五，极巨化之神：无极汰那","超限修复∽神技"],"a":3,"d":"m3-001","an":"e107","k":"name","x":"出自《精灵阶级第一章》"},{"q":"效果：「选定任意一只普通精灵，封为一级神，有阶级与神威，血值增加4万，攻击增加3万。 该精灵有3次使用机会。该封神为机制认可，无法被抵消。」\n这是哪一张？","o":["（2）阳之极","（一），诛仙","第六，七层","（二），逆袭封神榜"],"a":3,"d":"m1-008","an":"e36","k":"name","x":"出自《第九期：九妖王归位》"},{"q":"「（2）阳之极」出自哪一篇？","o":["第九期：九妖王归位","第二十六期：隐曜洞徽","第二十八期：隐曜逆元","第十期：新世纪~未来纪元"],"a":0,"d":"m1-008","an":"e8","k":"src","x":"原文：《第九期：九妖王归位》"},{"q":"「50.巳蛇」的效果是？","o":["先起三张，看后放回，若败则起另外三张","除青龙之力、麒麟瑞兽两妖王之外，在其它妖王领域之内（四妖王）若存在逃跑玩家，则该妖王次数重置。","复活，并持续2万暴击","恐惧：令任意玩家停止行动、不可行动、不可用技能一次。"],"a":3,"d":"m2-005","an":"e160","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"「（一），诛仙」的效果是？","o":["当集齐15张神兽级别及以上的精灵+一位一级神+一位圣兽时，可进行如下2选1： ①焚灭所有玩家手牌，本局直接获胜。 ②焚灭起牌区与神兽区，直接开启决战。","当有人使用技能卡后，该玩家需要献祭1只精灵。","每有人使用技能卡时，我方需要献祭3只精灵。 当七层印记叠满，获得奖励：2只神兽+5张牌。","共七层印记，每叠加一层需要完成对应需求。 第每层印记对应第每张技能卡，从获得该妖神时诛仙自动触发。 全场参与。"],"a":3,"d":"m1-008","an":"e32","k":"body","x":"出自《第九期：九妖王归位》"},{"q":"「7.霸下」出自哪一篇？","o":["第三期：五行元素","第二十五期：祈愿护梦~庆兔年","第二十六期：隐曜洞徽","第三十一期：龙生九子联动"],"a":3,"d":"m1-021","an":"e25","k":"src","x":"原文：《第三十一期：龙生九子联动》"},{"q":"「52.申猴」的效果是？","o":["恐惧：令任意玩家停止行动、不可行动、不可用技能一次。","复活，并持续2万暴击","可收取局内已阵亡精灵，获一次使用机会","满血时，血值×2，残血或阵亡时仅增1倍血"],"a":3,"d":"m2-005","an":"e162","k":"body","x":"出自《第九模式：觉醒之战》"},{"q":"效果：「处理一直以来未解决的神兽机制，开创新模式以适配完善“终决”弊端，创造新型强度技能卡。 完善三大机制：模式决战、技能威望、神兽威望」\n这是哪一张？","o":["太初无极","①抽神兽机制调改","⑤版本介绍","不断跨越再超越"],"a":3,"d":"core-003","an":"e91","k":"name","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"「4.晋神之路额外回合」的效果是？","o":["全场首只精灵是原始体，所有玩家可任意叠加一张非阶级进化体。","首位特权妖神级 提示：该技能所有解释权归系统所有。","每位玩家每场仅触发2张技能卡。","本场我方累计打出一万伤害。"],"a":2,"d":"m2-007","an":"e4","k":"body","x":"出自《第十一模式：诸神愚戏》"},{"q":"「3.窥视」出自哪一篇？","o":["第九期：九妖王归位","第二期：庆牛年~喜气冲天","第三十一期：龙生九子联动","第三十七期：斩神联动"],"a":1,"d":"m1-003","an":"e10","k":"src","x":"原文：《第二期：庆牛年~喜气冲天》"},{"q":"「4.睚眦」出自哪一篇？","o":["关于26年专属年卡和限定年卡的额外说明","第三十一期：龙生九子联动","第三十二期：灵兽宫~珍宝秘笈","第二十七期：天启降临~神界宙轨"],"a":1,"d":"m1-021","an":"e22","k":"src","x":"原文：《第三十一期：龙生九子联动》"},{"q":"「7.子鼠」出自哪一篇？","o":["第十期：新世纪~未来纪元","第十二期：十二生肖","第六期：宇宙原理","第三十七期：斩神联动"],"a":1,"d":"m1-011","an":"e10","k":"src","x":"原文：《第十二期：十二生肖》"},{"q":"「㉜霸下」出自哪一篇？","o":["第十二模式：铠甲勇士~铠传","第四模式：混沌之战","模式总介绍","第十模式：帝关之战"],"a":3,"d":"m2-006","an":"e101","k":"src","x":"原文：《第十模式：帝关之战》"},{"q":"效果：「反伤1次，我方受伤为0，以自身血值反伤」\n这是哪一张？","o":["1.摩羯座","9.金牛座","12.巨蟹座","4.处女座"],"a":1,"d":"m1-012","an":"e9","k":"name","x":"出自《第十三期：十二星座》"},{"q":"「第一级：妖神级」出自哪一篇？","o":["第十期：新世纪~未来纪元","第十一期：雾山五行","第九期：九妖王归位","技能卡阶级第一章"],"a":3,"d":"m1-001","an":"e3","k":"src","x":"原文：《技能卡阶级第一章》"},{"q":"效果：「对同系一击必杀，对异系伤害x2」\n这是哪一张？","o":["4.睚眦","6.狻猊","5.囚牛","7.霸下"],"a":2,"d":"m1-021","an":"e23","k":"name","x":"出自《第三十一期：龙生九子联动》"},{"q":"「10.隐身卡」出自哪一篇？","o":["第三十九期：诸神愚戏","第一期：除魔卫道","第四十期：铠甲勇士~铠传","第三十一期：龙生九子联动"],"a":1,"d":"m1-002","an":"e12","k":"src","x":"原文：《第一期：除魔卫道》"},{"q":"效果：「共七层印记，每叠加一层需要完成对应需求。 第每层印记对应第每张技能卡，从获得该妖神时诛仙自动触发。 全场参与。」\n这是哪一张？","o":["第四，五层","（二），逆袭封神榜","（一），诛仙","（1）灭妖神火"],"a":2,"d":"m1-008","an":"e32","k":"name","x":"出自《第九期：九妖王归位》"},{"q":"效果：「每次伤害无视护盾，本场伤害X2。」\n这是哪一张？","o":["7.霸下","6.狻猊","4.睚眦","5.囚牛"],"a":2,"d":"m1-021","an":"e22","k":"name","x":"出自《第三十一期：龙生九子联动》"},{"q":"效果：「可重抽神兽或重获技能卡或重置精灵1次使用机会，视情况而定。」\n这是哪一张？","o":["9.金牛座","8.天秤座","10.水瓶座","6.天蝎座"],"a":3,"d":"m1-012","an":"e6","k":"name","x":"出自《第十三期：十二星座》"},{"q":"效果：「反伤1次，我方受伤为0，以自身血值反伤」\n这是哪一张？","o":["20.双子座","37.星系","27.金牛座","30.巨蟹座"],"a":2,"d":"m2-004","an":"e74","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"效果：「当我方血值高于对方时，可一击必杀」\n这是哪一张？","o":["8.天秤座","4.处女座","10.水瓶座","11.白羊座"],"a":0,"d":"m1-012","an":"e8","k":"name","x":"出自《第十三期：十二星座》"},{"q":"效果：「本回合内结束任意攻击，三回合后再次现身。」\n这是哪一张？","o":["3.抗疫情卡","2.幻影卡","7.幸运卡","10.隐身卡"],"a":3,"d":"m1-002","an":"e12","k":"name","x":"出自《第一期：除魔卫道》"},{"q":"效果：「①增加技能卡使用数量 ②无视所有技能卡本回合」\n这是哪一张？","o":["8.保护卡","3.抗疫情卡","14.王权卡","9.贼卡"],"a":2,"d":"m1-002","an":"e16","k":"name","x":"出自《第一期：除魔卫道》"},{"q":"效果：「第一代版本：除魔卫道、庆牛年」\n这是哪一张？","o":["①抽神兽机制调改","天启系列","光之巨人特性","⑤版本介绍"],"a":3,"d":"core-003","an":"e62","k":"name","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"},{"q":"效果：「收取对方精灵，仅1次使用机会」\n这是哪一张？","o":["35.斗系","30.巨蟹座","29.白羊座","26.天秤座"],"a":2,"d":"m2-004","an":"e76","k":"name","x":"出自《第八模式：创世纪~神器之战》"},{"q":"「2.失魂符/定身符」出自哪一篇？","o":["第三十六期：守望新星~新生气象","第一期：除魔卫道","第三十八期：完美世界~帝关之战","第三十期：幻梦游园：联动梦幻西游"],"a":3,"d":"m1-020","an":"e20","k":"src","x":"原文：《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「5.亥猪」出自哪一篇？","o":["第十二期：十二生肖","第三期：五行元素","第三十二期：灵兽宫~珍宝秘笈","第三十四期：终战之巅"],"a":0,"d":"m1-011","an":"e8","k":"src","x":"原文：《第十二期：十二生肖》"},{"q":"效果：「对同系一击必杀，对异系伤害x2」\n这是哪一张？","o":["真伤，对精灵进行伤害加成","㉙睚眦","㉚囚牛","㉜霸下"],"a":2,"d":"m2-006","an":"e99","k":"name","x":"出自《第十模式：帝关之战》"},{"q":"「真伤，对精灵进行伤害加成」的效果是？","o":["满血时用获得2个护盾，残血时用获得1个护盾和一次行动。","①金甲神衣：活动级 仅在承受致命伤害时，将我方血值作为攻击返还给对方，并且此次我方受伤为0。 ②灵魂摆渡：活动级","每次伤害无视护盾，本场伤害X2。","普通：+3000 阶级：+6000"],"a":3,"d":"m2-006","an":"e88","k":"body","x":"出自《第十模式：帝关之战》"},{"q":"效果：「令每之极巨化精灵(Vmax)的攻击和血值额外加4万;每只极巨化精灵之间无弱抗影响，且不受非极巨化精灵弱抗影响，极巨化效果同样对迦勒尔精灵生效。」\n这是哪一张？","o":["③三圣护体∽神技","②神罚效果∽神技","②圣洁领域∽神技","极巨化效果"],"a":3,"d":"m3-001","an":"e109","k":"name","x":"出自《精灵阶级第一章》"},{"q":"效果：「其余人各起一张牌，使用者弃牌一张牌。」\n这是哪一张？","o":["6.神权卡","8.保护卡","2.幻影卡","9.贼卡"],"a":3,"d":"m1-002","an":"e11","k":"name","x":"出自《第一期：除魔卫道》"},{"q":"「（一），诛仙」出自哪一篇？","o":["第二十五期：祈愿护梦~庆兔年","第二十九期：幻世阅书~终末","第九期：九妖王归位","第二期：庆牛年~喜气冲天"],"a":2,"d":"m1-008","an":"e32","k":"src","x":"原文：《第九期：九妖王归位》"},{"q":"「①五灵之力」出自哪一篇？","o":["第十二期：十二生肖","第二期：庆牛年~喜气冲天","第九期：九妖王归位","第三期：五行元素"],"a":3,"d":"m1-004","an":"e16","k":"src","x":"原文：《第三期：五行元素》"},{"q":"「10.翻江倒海」的效果是？","o":["佩戴给龙属性精灵时，将加持免疫弱抗， 阶级伤害无效、一击必杀无效， 同时血攻防×2","濒危时，增加一个护盾，并令与对方 同级别的精灵除自己外都下场","①抽神兽时三选一 ②起牌时九选三 二选一","每次攻击附带全场每人的50%"],"a":2,"d":"m1-020","an":"e34","k":"body","x":"出自《第三十期：幻梦游园：联动梦幻西游》"},{"q":"「天启系列」的效果是？","o":["天启降临·神界宙轨2023年4月28日 下午3点","出场的一回合免疫伤害、阶级、负面效果 并持续免疫弱抗，但我方血值与光之巨人血值没有关联，只计总伤害。 ③能量石专门抽神兽，光之石专门抽奥特曼，奥特曼位于英雄","太初之时，混沌黑暗，以光明显现， 大道初立，是为正道。","处理一直以来未解决的神兽机制，开创新模式以适配完善“终决”弊端，创造新型强度技能卡。 完善三大机制：模式决战、技能威望、神兽威望"],"a":0,"d":"core-003","an":"e150","k":"body","x":"出自《关于游戏发展状况与游戏对局跟踪反馈》"}];
